      "file": ".github/workflows/future-bottleneck.yml",
      "name": "Future bottleneck body candidates",
      "on": {
        "push": {
          "branches": [
            "main",
            "codex/future-bottleneck",
            "codex/bct-v33-implementation"
          ],
          "paths": [
            "src/bct/future_*.py",
            "tests/test_future*.py",
            ".github/scripts/future*.py",
            "docs/v33-quality-*.json",
            ".github/workflows/future-bottleneck.yml"
          ]
        },
        "workflow_dispatch": {
          "inputs": {
            "backlog_body_recovery": {
              "description": "Recover a frozen operational body selection through the existing pipeline",
              "type": "boolean",
              "default": "false"
            }
          }
        },
        "workflow_run": {
          "workflows": [
            "RSS live environment check"
          ],
          "types": [
            "completed"
          ],
          "branches": [
            "main"
          ]
        },
        "repository_dispatch": {
          "types": [
            "bct-operating-publication"
          ]
        },
        "schedule": [
          {
            "cron": "45 22,10 * * *"
          }
        ]
      },
      "concurrency": {
        "group": "future-bottleneck-results",
        "cancel-in-progress": "false"
      },
      "jobs": {
        "backlog-body-recovery": {
          "if": "${{ github.event_name == 'workflow_dispatch' && inputs.backlog_body_recovery }}",
          "timeout-minutes": "35",
          "permissions": null
        },
        "candidates": {
          "if": "${{ (github.event_name == 'workflow_dispatch' && !inputs.backlog_body_recovery) || (github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'schedule' || github.event_name == 'repository_dispatch' || (github.event_name == 'workflow_run' && github.event.workflow_run.conclusion == 'success'))) }}",
          "timeout-minutes": "75",
          "permissions": null
        }
      }
    },
