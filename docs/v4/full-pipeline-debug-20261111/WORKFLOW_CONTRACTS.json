    {
      "file": ".github/workflows/rss-live-check.yml",
      "name": "RSS live environment check",
      "on": {
        "workflow_dispatch": {
          "inputs": {
            "live_snapshot_only": {
              "description": "Acquire only an explicitly selected new LIVE batch, without RSS or backlog work",
              "type": "boolean",
              "default": "false"
            },
            "live_document_ids": {
              "description": "JSON array of 1 to 20 newly collected document IDs",
              "type": "string",
              "default": "[]"
            }
          }
        },
        "schedule": [
          {
            "cron": "0 18 * * *"
          },
          {
            "cron": "0 22 * * *"
          },
          {
            "cron": "0 2 * * *"
          },
          {
            "cron": "0 6 * * *"
          },
          {
            "cron": "0 10 * * *"
          },
          {
            "cron": "0 14 * * *"
          }
        ]
      },
      "concurrency": {
        "group": "rss-canonical-data",
        "cancel-in-progress": "false"
      },
      "jobs": {
        "collect": {
          "if": "${{ !inputs.live_snapshot_only }}",
          "timeout-minutes": "55",
          "permissions": null
        },
        "live-snapshot": {
          "if": "${{ github.event_name == 'workflow_dispatch' && inputs.live_snapshot_only }}",
          "timeout-minutes": "10",
          "permissions": null
        }
      }
    },
