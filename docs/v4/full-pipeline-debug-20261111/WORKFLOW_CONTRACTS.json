      "name": "V4 CPU private research consumer",
      "on": {
        "workflow_run": {
          "workflows": [
            "New precursor evidence acquisition"
          ],
          "types": [
            "completed"
          ]
        },
        "workflow_dispatch": {
          "inputs": {
            "purpose": {
              "type": "choice",
              "options": [
