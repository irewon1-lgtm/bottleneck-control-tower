        "group": "bct-readonly-pages",
        "cancel-in-progress": "true"
      },
      "jobs": {
        "build": {
          "if": "${{ github.event_name != 'workflow_run' ||\n    (github.event.workflow_run.conclusion == 'success' &&\n     github.event.workflow_run.head_branch == 'codex/bct-v4-integration' &&\n     github.event.workflow_run.head_repository.full_name == github.repository &&\n     github.event.workflow_run.event == 'push') }}",
          "timeout-minutes": "15",
          "permissions": null
        },
        "deploy": {
          "if": "needs.build.outputs.publish == 'yes'",
          "timeout-minutes": "10",
          "permissions": null
        }
      }
    },
    {
      "file": ".github/workflows/v4-cpu-main-cache-seed.yml",
      "name": "V4 CPU main cache seed",
      "on": {
        "workflow_dispatch": ""
      },
      "concurrency": {
        "group": "v4-cpu-main-cache-seed",
        "cancel-in-progress": "false"
      },
      "jobs": {
        "seed": {
          "if": "${{ github.ref == 'refs/heads/main' }}",
          "timeout-minutes": "10",
          "permissions": null
        }
      }
    },
    {
      "file": ".github/workflows/v4-cpu-private-research.yml",
      "name": "V4 CPU private research consumer",
      "on": {
        "workflow_run": {
          "workflows": [
            "New precursor evidence acquisition"
          ],
          "types": [
            "completed"
          ]
        },
        "workflow_dispatch": {
          "inputs": {
            "purpose": {
              "type": "choice",
              "options": [
                "seed",
                "recovery-check",
                "bridge-recover"
              ],
              "default": "seed"
            }
          }
        }
      },
      "concurrency": {
        "group": "v4-cpu-private-research-single-writer",
        "cancel-in-progress": "false"
      },
      "jobs": {
        "research": {
          "if": "${{ vars.BCT_V4_CPU_CODE_SHA == '221fa92b1cbff8950716ec373eac793ca340c873' && github.ref == 'refs/heads/main' && github.event_name == 'workflow_run' && vars.BCT_V4_CPU_RESEARCH_ENABLED == 'true' && github.event.workflow_run.head_branch == 'main' && github.event.workflow_run.conclusion == 'success' }}",
          "timeout-minutes": "10",
          "permissions": null
        },
        "publish": {
          "if": "${{ always() && github.ref == 'refs/heads/main' && (github.event_name == 'workflow_dispatch' || needs.research.result == 'success') }}",
          "timeout-minutes": "5",
          "permissions": null
        }
      }
    },
    {
      "file": ".github/workflows/v4-cpu-private-settings-check.yml",
      "name": "V4 CPU private settings check",
      "on": {
        "workflow_dispatch": {
          "inputs": {
            "remote_roundtrip": {
              "type": "boolean",
              "default": "false",
              "description": "Verify non-sensitive private remote storage; never seed production or enable CPU"
            },
            "auth_denials_only": {
              "type": "boolean",
              "default": "false",
              "description": "Diagnose authentication and public-ref denials without retrying private-repo access"
            }
          }
        }
      },
      "concurrency": {
        "group": "v4-cpu-private-settings-check",
        "cancel-in-progress": "false"
      },
      "jobs": {
        "publisher_permission_check": {
          "if": "${{ github.ref == 'refs/heads/main' }}",
          "timeout-minutes": "5",
          "permissions": null
        }
      }
    }
