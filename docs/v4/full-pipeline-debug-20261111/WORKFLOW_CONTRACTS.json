            }
          }
        }
      },
      "concurrency": {
        "group": "v4-cpu-private-research-single-writer",
        "cancel-in-progress": "false"
      },
      "jobs": {
        "official-state-read": {
          "if": "${{ github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/codex/bct-v4-integration' && inputs.purpose == 'official-state-read' }}",
