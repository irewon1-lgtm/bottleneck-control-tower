          "permissions": null
        },
        "monthly-storage-trial": {
          "if": "${{ github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/codex/bct-v4-integration' && inputs.purpose == 'monthly-storage-trial' }}",
          "timeout-minutes": "18",
          "permissions": null
        },
        "archive-storage-trial": {
          "if": "${{ github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/codex/bct-v4-integration' && inputs.purpose == 'archive-storage-trial' }}",
          "timeout-minutes": "18",
          "permissions": null
        },
        "research": {
          "if": "${{ vars.BCT_V4_CPU_CODE_SHA == '221fa92b1cbff8950716ec373eac793ca340c873' && github.ref == 'refs/heads/main' && github.event_name == 'workflow_run' && vars.BCT_V4_CPU_RESEARCH_ENABLED == 'true' && github.event.workflow_run.head_branch == 'main' && github.event.workflow_run.conclusion == 'success' }}",
          "timeout-minutes": "10",
          "permissions": null
        },
        "publish": {
          "if": "${{ always() && github.ref == 'refs/heads/main' && (github.event_name == 'workflow_dispatch' || needs.research.result == 'success') }}",
          "timeout-minutes": "5",
          "permissions": null
        },
        "q1-key": {
          "if": "${{ github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/codex/bct-v4-integration' && inputs.purpose == 'q1-transfer-key' }}",
          "timeout-minutes": "3",
          "permissions": null
        },
        "q1-publish": {
          "if": "${{ github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/codex/bct-v4-integration' && inputs.purpose == 'q1-publish' }}",
          "timeout-minutes": "5",
          "permissions": null
        },
        "q1-connectivity": {
          "if": "${{ github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/codex/bct-v4-integration' && inputs.purpose == 'q1-connectivity' }}",
          "timeout-minutes": "3",
          "permissions": null
        },
        "q1-source-prior": {
          "if": "${{ github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/codex/bct-v4-integration' && (inputs.purpose == 'q1-source-batch' || inputs.purpose == 'q1-trade-resume' || inputs.purpose == 'q2-review' || inputs.purpose == 'q1-storage-check' || inputs.purpose == 'q1-quality-Q2' || inputs.purpose == 'q1-recover-result' || inputs.purpose == 'q2-counterpart' || inputs.purpose == 'q2-relations' || inputs.purpose == 'official-sources' || inputs.purpose == 'official-discovery' || inputs.purpose == 'official-bidirectional') }}",
          "timeout-minutes": "5",
          "permissions": null
        },
        "q1-source-process": {
