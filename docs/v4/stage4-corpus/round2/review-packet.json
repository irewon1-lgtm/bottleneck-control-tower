      "raw_sha256": "0193642aa11f3ba0a3e4082f2063dbd982a0b649e0f5a1b5323f2e9db04c12dc",
      "origin_url": "https://www.airbus.com/en/newsroom/press-releases/2026-09-linfox-takes-delivery-of-first-airbus-h160-in-australia",
      "published_at": "2026-09-15",
      "body_path": "docs/v4/stage4-corpus/round2/text/d5d8e1ce503116f4bfe4b5cb8f7beb358b2cb7f760a2323420ad54648752f1cb.txt",
      "body_characters": 3521,
      "windows": [
        {
          "start": 0,
          "end": 246,
          "text": "Melbourne, Australia, 15 September 2026 – Melbourne-based logistics and supply chain enterprise, Linfox Group, has taken delivery of Australia’s first Airbus H160 helicopter, marking a landmark moment for next-generation rotorcraft in the region."
        },
        {
          "start": 247,
          "end": 567,
          "text": "With this delivery, Linfox became the first operator in Australia to bring the twin-engine Airbus H160 into service. The state-of-the-art helicopter will support the business and corporate aviation requirements of the Linfox Group, operating across Australia’s diverse geography from urban hubs to regional destinations."
        }
      ],
      "full_document_review": false
    },
    {
      "document_id": "v4doc-c3ce56c9861165f5d811a5897473c74755883b871135a747a0f470dca020c396",
      "body_sha256": "e472564e0ed11b9ed84e99db8b0839afc390904724dcbe1d69e9ee935b36b46a",
      "raw_sha256": "7f62cd1bc1e41f211377455326d4503ceb95e66f90a76604cadb36549ad55baa",
      "origin_url": "https://www.airbus.com/en/newsroom/press-releases/2026-10-airbus-u740-valkyrie-uncrewed-combat-aircraft-takes-off-for-its-maiden-flight-in-europe",
      "published_at": "2026-10-12",
      "body_path": "docs/v4/stage4-corpus/round2/text/e472564e0ed11b9ed84e99db8b0839afc390904724dcbe1d69e9ee935b36b46a.txt",
      "body_characters": 3480,
      "windows": [
        {
          "start": 0,
          "end": 446,
          "text": "Ottobrunn / Taufkirchen, Germany, 12 October 2026 – Airbus, in partnership with Kratos Defense & Security Solutions, Inc. (NASDAQ: KTOS), has successfully completed the first flight of the “U740-Valkyrie” in Europe. This key milestone confirms that Airbus and Kratos are on track to deliver a combat-ready uncrewed Collaborative Combat Aircraft (CCA) by 2029, addressing the operational requirements of the German and other European Armed Forces."
        }
      ],
      "full_document_review": false
    },
