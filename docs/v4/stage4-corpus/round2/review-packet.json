      "windows": [
        {
          "start": 1986,
          "end": 2203,
          "text": "Additionally, the Board of Directors has designated Mark Dunkerley to serve as Chair of the Remuneration, Nomination and Governance Committee and Lead Independent Director, succeeding Amparo Moraleda in this capacity."
        }
      ],
