      "body_characters": 2594,
      "windows": [
        {
          "start": 1489,
          "end": 1792,
          "text": "The Romanian Air Force currently operates the IAR-330 Puma, a locally produced version of the Puma under an Aerospatiale license. The 12 H225Ms will initiate the replacement of the Puma fleet for conventional and special operations. Romania has also previously ordered two H215Ms in naval configuration."
        },
        {
          "start": 1793,
          "end": 1979,
          "text": "This contract is the second one signed by Romania and Airbus Helicopters in the frame of the SAFE initiative, with seven H160 and five H145 recently ordered for public services missions."
        }
      ],
      "full_document_review": false
    },
    {
      "document_id": "v4doc-e4dbafd178d94c5f2f913f2cb9a6a12b108f39663fbe6e6022c451a0a9c03fa3",
