# NOT ACTIVE: owner repository/secret setup and exact-version private storage review remain BLOCKED.
# Replace the old public write-token proposal; no public contents:write, no raw artifacts/cache.
# Existing main-scoped runtime cache is mandatory. No install/download fallback.
name: V4 CPU private research consumer
on:
  workflow_run:
    workflows: [New precursor evidence acquisition]
    types: [completed]
  workflow_dispatch:
    inputs:
      purpose:
        type: choice
        options: [verify-scope, seed]
        default: verify-scope
permissions:
  contents: read
  actions: read
concurrency:
  group: v4-cpu-private-research-single-writer
  cancel-in-progress: false
env:
  PYTHONPATH: src
  CPU_CODE_SHA: ${{ vars.BCT_V4_CPU_CODE_SHA }}
jobs:
  research:
    if: ${{ false && github.ref == 'refs/heads/main' && github.event_name == 'workflow_run' && vars.BCT_V4_CPU_RESEARCH_ENABLED == 'true' && github.event.workflow_run.head_branch == 'main' && github.event.workflow_run.conclusion == 'success' }}
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    env:
      GH_TOKEN: ${{ github.token }}
      BCT_V4_STATE_PASSPHRASE: ${{ secrets.BCT_V4_STATE_PASSPHRASE }}
      HF_HUB_OFFLINE: '1'
      TRANSFORMERS_OFFLINE: '1'
      OMP_NUM_THREADS: '4'
      MKL_NUM_THREADS: '4'
    steps:
      - name: Require a reviewed immutable code SHA
        run: test "${#CPU_CODE_SHA}" = 40 && [[ "$CPU_CODE_SHA" =~ ^[0-9a-f]+$ ]]
      - uses: actions/checkout@v4
        with:
          ref: ${{ env.CPU_CODE_SHA }}
          persist-credentials: false
      - uses: actions/setup-python@v5
        id: python
        with:
          python-version: '3.12.15'
      - name: Free guard and exact existing runtime key
        id: key
        env:
          PYTHON_VERSION: ${{ steps.python.outputs.python-version }}
          LOCK_SHA: ${{ hashFiles('scripts/v4/requirements.lock','docs/v4/cpu-automation/preflight/model-manifest.json') }}
        run: |
          timeout 120 python tools/v4_cpu_preflight.py guard --output var/v4/cpu-private/free.json
          echo "key=v4-cpu-runtime-${RUNNER_OS}-${RUNNER_ARCH}-${PYTHON_VERSION}-${LOCK_SHA}" >> "$GITHUB_OUTPUT"
      - uses: actions/cache/restore@v4
        with:
          key: ${{ steps.key.outputs.key }}
          fail-on-cache-miss: true
          path: |
            .v4-cpu-env
            .v4-cpu-runtime
      - uses: actions/cache/restore@v4
        with:
          key: v4-cpu-private-bridge-prior-${{ github.run_id }}-${{ github.run_attempt }}
          restore-keys: v4-cpu-private-bridge-
          fail-on-cache-miss: true
          path: var/v4/cpu-private/bridge
      - name: Authenticate and restore private input; missing/corrupt stops
        run: timeout 120 python tools/v4_cpu_private.py unseal --packet var/v4/cpu-private/bridge/state.gpg --checkpoint var/v4/cpu-private/prior
      - name: Verify original scheduled RSS and receive existing data only
        env:
          ACQUISITION_RUN: ${{ github.event.workflow_run.id }}
        run: |
          timeout 120 python - <<'PYCODE'
          from bct.v4.cpu_operations import github_schedule_context,verified_schedule
          import os
          proof=verified_schedule(github_schedule_context())
          with open(os.environ['GITHUB_ENV'],'a')as out:out.write('RSS_RUN='+str(proof['RSS_run_id'])+'\n')
          PYCODE
          timeout 120 gh run download "$RSS_RUN" --name rss-live-result --dir var/v4/cpu-private/rss
          timeout 120 gh run download "$ACQUISITION_RUN" --name precursor-private-cache --dir var/v4/cpu-private/source
      - name: Consume approved new windows with the existing bounded CPU queue
        run: timeout 120 .v4-cpu-env/bin/python tools/v4_cpu_private.py process --checkpoint var/v4/cpu-private/prior --output var/v4/cpu-private/observation.json
      - name: Seal output; only ciphertext crosses jobs
        run: timeout 120 python tools/v4_cpu_private.py seal --checkpoint var/v4/cpu-private/next-checkpoint --packet var/v4/cpu-private/result/state.gpg --parent-file var/v4/cpu-private/prior/parent.json
      - uses: actions/cache/save@v4
        with:
          key: v4-cpu-private-result-${{ github.run_id }}-${{ github.run_attempt }}
          path: var/v4/cpu-private/result
  publish:
    needs: research
    if: ${{ always() && github.ref == 'refs/heads/main' && (github.event_name == 'workflow_dispatch' || needs.research.result == 'success') }}
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    env:
      GH_TOKEN: ${{ github.token }}
      BCT_V4_STATE_PASSPHRASE: ${{ secrets.BCT_V4_STATE_PASSPHRASE }}
    steps:
      - name: Require a reviewed immutable code SHA
        run: test "${#CPU_CODE_SHA}" = 40 && [[ "$CPU_CODE_SHA" =~ ^[0-9a-f]+$ ]]
      - uses: actions/checkout@v4
        with:
          ref: ${{ env.CPU_CODE_SHA }}
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12.15'
      - name: Free/cache guard; private repo is storage only, no private Actions
        run: timeout 120 python tools/v4_cpu_preflight.py guard --output var/v4/cpu-private/free.json
      - name: Verify private write and actual public main/data write denials
        env:
          BCT_V4_PRIVATE_STATE_TOKEN: ${{ secrets.BCT_V4_PRIVATE_STATE_TOKEN }}
        run: timeout 120 python tools/v4_cpu_private.py verify-scope --output var/v4/cpu-private/scope.json
      - name: Prepare existing verified seed without rereading or empty reset
        if: ${{ github.event_name == 'workflow_dispatch' && inputs.purpose == 'seed' }}
        run: timeout 120 python tools/v4_cpu_private.py prepare-seed
      - uses: actions/cache/restore@v4
        if: ${{ github.event_name == 'workflow_run' }}
        with:
          key: v4-cpu-private-result-${{ github.run_id }}-${{ github.run_attempt }}
          fail-on-cache-miss: true
          path: var/v4/cpu-private/result
      - name: Authenticate CPU result, no model or upstream code execution
        if: ${{ github.event_name == 'workflow_run' }}
        run: timeout 120 python tools/v4_cpu_private.py unseal --packet var/v4/cpu-private/result/state.gpg --checkpoint var/v4/cpu-private/checkpoint
      - name: Private CAS publish and fresh remote hash/table restore
        if: ${{ github.event_name == 'workflow_run' || inputs.purpose == 'seed' }}
        env:
          BCT_V4_PRIVATE_STATE_TOKEN: ${{ secrets.BCT_V4_PRIVATE_STATE_TOKEN }}
        run: |
          if test -f var/v4/cpu-private/checkpoint/parent.json; then
            timeout 120 python tools/v4_cpu_private.py publish --parent-file var/v4/cpu-private/checkpoint/parent.json --output var/v4/cpu-private/published.json
          else
            timeout 120 python tools/v4_cpu_private.py publish --output var/v4/cpu-private/published.json
          fi
      - name: Seal acknowledged private state for next read-only CPU job
        if: ${{ github.event_name == 'workflow_run' || inputs.purpose == 'seed' }}
        run: timeout 120 python tools/v4_cpu_private.py seal --packet var/v4/cpu-private/bridge/state.gpg --parent-file var/v4/cpu-private/published.json
      - uses: actions/cache/save@v4
        if: ${{ github.event_name == 'workflow_run' || inputs.purpose == 'seed' }}
        with:
          key: v4-cpu-private-bridge-${{ github.run_id }}-${{ github.run_attempt }}
          path: var/v4/cpu-private/bridge
# No raw DB/source artifact upload, code execution from upstream, public Git writes,
# model setup, RSS refetch, external AI, automatic S2/S3, LIVE or UI deployment.
# Seven-day start exists only after publisher remote restore and receipt ACK.
