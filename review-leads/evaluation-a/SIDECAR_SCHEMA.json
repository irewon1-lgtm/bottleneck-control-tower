{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BCT_A_HYPOTHESIS_SIDECAR_1 — preparation only",
  "type": "object",
  "required": ["schema_version", "review_id", "first_card_sha256", "hypothesis_version", "hypothesis_hash", "target", "scope_fields", "observed_changes", "evidence", "claim", "assumptions", "prediction_period", "refutation_conditions", "exposure", "sidecar_recorded_at", "review_lead_first_at", "market_candidate_first_at", "T_scope", "cohort", "performance_evaluation"],
  "properties": {
    "schema_version": {"const": "BCT_A_HYPOTHESIS_SIDECAR_1"},
    "hypothesis_version": {"enum": ["H0", "H1"]},
    "hypothesis_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "first_card_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target": {"type": "string"},
    "scope_fields": {"type": "object", "description": "Literal values and existing source references; no new five-field completeness gate"},
    "observed_changes": {"type": "array"},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["document_id", "body_sha256", "quote", "locator"]}},
    "claim": {"type": "string"},
    "assumptions": {"type": "array"},
    "prediction_period": {"description": "Source expression/attributed hypothesis period, or UNKNOWN; no normalization required"},
    "refutation_conditions": {"type": "array"},
    "exposure": {"type": "object", "required": ["input_documents", "started_at", "completed_at", "annotator", "method", "web_search_used", "search_references", "model_knowledge_basis"]},
    "market_candidate_first_at": {"const": "UNKNOWN"},
    "T_scope": {"const": "UNKNOWN"},
    "cohort": {"const": "EXPLORATORY_EXCLUDED"},
    "performance_evaluation": {"const": false}
  },
  "allOf": [{"if": {"properties": {"hypothesis_version": {"const": "H1"}}}, "then": {"required": ["previous_hypothesis_hash", "previous_recorded_at"]}}]
}
