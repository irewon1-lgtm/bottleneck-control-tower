# PREPARATION ONLY: outside .github/workflows; no activation in A.
# Schedule is a proposal, not approved. Main incorporation requires separate approval.
name: BCT evaluation observer DRAFT
on:
  schedule:
    - cron: '30 3,15 * * *'
  workflow_dispatch:
permissions:
  contents: read
  actions: read
concurrency:
  group: review-lead-evaluation-observer
  cancel-in-progress: false
jobs:
  observe:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Read existing metadata only
        env:
          GH_TOKEN: ${{ github.token }}
        run: python tools/review_evaluation_a.py --observer-id "$GITHUB_RUN_ID" --output var/evaluation-a/observation.json
      - uses: actions/upload-artifact@v4
        with:
          name: evaluation-observer
          path: var/evaluation-a/observation.json
          retention-days: 30
          if-no-files-found: error
