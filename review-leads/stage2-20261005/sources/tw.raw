485ab7fac9a1df/69dec4efd3f512ead630747e_Hero%20Image%204.avif" loading="lazy" sizes="(max-width: 1919px) 100vw, 1812px" srcset="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4efd3f512ead630747e_Hero%20Image%204-p-500.avif 500w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4efd3f512ead630747e_Hero%20Image%204-p-800.avif 800w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4efd3f512ead630747e_Hero%20Image%204-p-1080.avif 1080w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4efd3f512ead630747e_Hero%20Image%204-p-1600.avif 1600w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4efd3f512ead630747e_Hero%20Image%204.avif 3774w" alt="Blonde woman and young girl sitting closely as the girl writes on a black clipboard with a red pen." class="image_cover"/></div><div class="image-wrap_hero-home-a rest"><img src="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4ef4163eea293910e69_Hero%20Image%205.avif" loading="lazy" sizes="(max-width: 479px) 100vw, 384px" srcset="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4ef4163eea293910e69_Hero%20Image%205-p-500.avif 500w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4ef4163eea293910e69_Hero%20Image%205.avif 800w" alt="An elderly couple sitting on a wooden dock by the water, holding hands and smiling, with trees in the background." class="image_cover"/></div><div class="image-wrap_hero-home-a rest"><img src="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4ef37c488423944797a_Hero%20Image%201.avif" loading="lazy" sizes="(max-width: 4096px) 100vw, 4096px" srcset="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4ef37c488423944797a_Hero%20Image%201-p-500.avif 500w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4ef37c488423944797a_Hero%20Image%201-p-800.avif 800w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4ef37c488423944797a_Hero%20Image%201-p-1080.avif 1080w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4ef37c488423944797a_Hero%20Image%201-p-1600.avif 1600w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4ef37c488423944797a_Hero%20Image%201-p-2000.avif 2000w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69dec4ef37c488423944797a_Hero%20Image%201.avif 4096w" alt="Woman with curly hair wearing a floral robe stands by a window holding a stovetop coffee maker." class="image_cover"/></div></div></div></div></div><div class="padding-global"><div class="w-layout-blockcontainer container-large w-container"><div class="p_hero-home-a"><p loader-text="" class="margin-0">Tungsten West plc are a mining development company focused on restarting the world class Hemerdon Tungsten mine located in South Devon, UK.</p></div></div></div></div><div class="animation_text"><div class="animation_text-wrap"><div class="sticky_text"><div data-wf-target="[[[&quot;69d6c3cf43485ab7fac9a263&quot;,&quot;43bf213e-955f-f07a-51c5-271f6e561f26&quot;],[]]]" class="text_home-video _1st"><div class="heading-style-h2 margin-0">Critical minerals Britain can rely on.</div></div><div data-wf-target="[[[&quot;69d6c3cf43485ab7fac9a263&quot;,&quot;43bf213e-955f-f07a-51c5-271f6e561f29&quot;],[]]]" class="text_home-video _2nd"><div class="heading-style-h2 margin-0">Lasting jobs for the South West.</div></div><div data-wf-target="[[[&quot;69d6c3cf43485ab7fac9a263&quot;,&quot;43bf213e-955f-f07a-51c5-271f6e561f2c&quot;],[]]]" class="text_home-video _3rd"><div class="heading-style-h2 margin-0">Hemerdon is where those two things meet.</div></div></div></div></div><div class="overlay_scroll"><div class="sticky-scroll"><div data-flip-target="" class="fill-element"><div data-poster-url="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df%2F69d6d1d5627023bc1670f13f_Drone%20Hero%20Video_poster.0000000.jpg" data-video-urls="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1