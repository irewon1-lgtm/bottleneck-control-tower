  [button]:where(.w-variant-1ff8d96e-78cc-eac8-de90-206ecdaded5f):hover .icon-wrap_button:where(.w-variant-1ff8d96e-78cc-eac8-de90-206ecdaded5f) {
    color: var(--_🎨-color--tokens---button--secondary--hover--icon);
  }
    
</style></div></a></div></div></div></section><section class="section_features"><div class="padding-global"><div class="w-layout-blockcontainer container-large w-container"><div data-w-id="789dd7e3-650a-7c75-7491-58576cc5c854" style="-webkit-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="features_headling"><div data-w-id="9c6e9b73-b2d7-ff49-e367-8e1031f32c22" style="-webkit-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="headline_features"><div class="master_label"><div class="icon-label"></div><div class="text-size-small">Tungsten</div></div><h2 class="text-color-black">One material. No real substitute. One dominant supplier. That&#x27;s the problem we&#x27;re solving.</h2></div><div data-w-id="ee4ecccd-cb12-4c69-7c3b-c015e2feb033" style="-webkit-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0"><a href="/project/tungsten" button="" data-wf--cta-primary--variant="primary" class="cta_primary w-inline-block"><div class="button_text-mask"><div button-text="" class="text-button">Understand the opportunity </div></div><div class="icon-wrap_button right"><div button-icon-right="" class="icon_button w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 12 12" fill="none">
  <path d="M2.5 6H9.5M9.5 6L6 2.5M9.5 6L6 9.5" stroke="currentColor" stroke-width="var(--_❇️-icon---icon-stroke)" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div><div button-icon-right="" class="icon_button w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 12 12" fill="none">
  <path d="M2.5 6H9.5M9.5 6L6 2.5M9.5 6L6 9.5" stroke="currentColor" stroke-width="var(--_❇️-icon---icon-stroke)" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div></div><div button-bg="" class="btn-bg"></div><div class="w-embed"><style>

  
  [button]:hover .icon-wrap_button {
    color: var(--_🎨-color--tokens---button--primary--Hover--icon);
  

  [button]:where(.w-variant-1ff8d96e-78cc-eac8-de90-206ecdaded5f):hover .icon-wrap_button:where(.w-variant-1ff8d96e-78cc-eac8-de90-206ecdaded5f) {
    color: var(--_🎨-color--tokens---button--secondary--hover--icon);
  }
    
</style></div></a></div></div><div class="master_features"><div class="card_feature"><div class="content_feature"><div class="title_feature text-color-dark"><div class="heading-style-h4 heading-alternative"><span class="title_feature-number">01</span><span>The material behind everything that matters</span></div></div><div class="feature_bottom-tile"><p>Tungsten has the highest melting point of any known element, the tensile strength no other metal can match, and a list of critical applications that only gets longer.</p><a button="" data-wf--cta-tertiary--variant="base" href="/project/tungsten" class="cta_tertiary w-inline-block"><div>Learn more</div><div class="icon-wrap_button tertiary"><div button-icon-right="" class="icon_button w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 16 16" fill="none">
  <path d="M3.33594 8.00004H12.6693M12.6693 8.00004L8.0026 3.33337M12.6693 8.00004L8.0026 12.6667" stroke="currentColor" stroke-width="var(--_❇️-icon---icon-stroke)" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div><div button-icon-right="" class="icon_button w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 16 16" fill="none">
  <path d="M3.33594 8.00004H12.6693M12.6693 8.00004L8.0026 3.33337M12.6693 8.00004L8.0026 12.6667" stroke="currentColor" stroke-width="var(--_❇️-icon---icon-stroke)" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div></div></a></div></div><div id="w-node-e38d24d3-06fb-3cb0-cede-619c6338e87e-fac9a263" class="image_feature"><img src="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69da22a36e9a24948822da04_The%20material%20behind%20everything%20that%20matters.avif" loading="lazy" sizes="(max-width: 767px) 100vw, 576px" srcset="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69da22a36e9a24948822da04_The%20material%20behind%20everything%20that%20matters-p-500.avif 500w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69da22a36e9a24948822da04_The%20material%20behind%20everything%20that%20matters-p-800.avif 800w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69da22a36e9a24948822da04_The%20material%20behind%20everything%20that%20matters.avif 1200w" alt="Two young women lying on grass, one smiling with eyes closed, the other relaxed with eyes closed." class="image_cover"/></div></div><div class="card_feature second"><div class="content_feature"><div class="title_feature"><div class="heading-style-h4 heading-alternative"><span class="title_feature-number">02</span><span>A supply problem hiding in plain sight</span></div></div><div class="feature_bottom-tile"><p class="margin-0">Over 80% of global tungsten supply has historically come from China. In 2025, China became a net importer. The concentration that made the market vulnerable is now making it critical.</p><a button="" data-wf--cta-tertiary--variant="white" href="/project/tungsten" class="cta_tertiary w-variant-f9c095d3-614f-bcb4-3e86-2e60f269b1db w-inline-block"><div>Learn more</div><div class="icon-wrap_button tertiary"><div button-icon-right="" class="icon_button w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 16 16" fill="none">
  <path d="M3.33594 8.00004H12.6693M12.6693 8.00004L8.0026 3.33337M12.6693 8.00004L8.0026 12.6667" stroke="currentColor" stroke-width="var(--_❇️-icon---icon-stroke)" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div><div button-icon-right="" class="icon_button w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 16 16" fill="none">
  <path d="M3.33594 8.00004H12.6693M12.6693 8.00004L8.0026 3.33337M12.6693 8.00004L8.0026 12.6667" stroke="currentColor" stroke-width="var(--_❇️-icon---icon-stroke)" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div></div></a></div></div><div id="w-node-f49f9cc8-1432-3467-ecbb-1c84d8b1a73f-fac9a263" class="image_feature"><img src="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69da22a3fd6292bdcda0430e_A%20supply%20problem%20hiding%20in%20plain%20sight.avif" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" srcset="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69da22a3fd6292bdcda0430e_A%20supply%20problem%20hiding%20in%20plain%20sight-p-500.avif 500w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69da22a3fd6292bdcda0430e_A%20supply%20problem%20hiding%20in%20plain%20sight-p-800.avif 800w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69da22a3fd6292bdcda0430e_A%20supply%20problem%20hiding%20in%20plain%20sight-p-1080.avif 1080w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69da22a3fd6292bdcda0430e_A%20supply%20problem%20hiding%20in%20plain%20sight.avif 2713w" alt="Smiling elderly man with glasses holding a smartphone in a garden with green plants in the background." class="image_cover"/></div></div><div class="card_feature third"><div class="content_feature"><div class="title_feature"><div class="heading-style-h4 heading-alternative"><span class="title_feature-number">03</span><span>The window for Western producers</span></div></div><div class="feature_bottom-tile"><p class="margin-0">As China&#x27;s export position shrinks, Western manufacturers, defence contractors, and governments are actively looking for reliable sovereign supply. The market is repricing. The timing for Hemerdon has never been better.</p><a button="" data-wf--cta-tertiary--variant="white" href="/project/tungsten" class="cta_tertiary w-variant-f9c095d3-614f-bcb4-3e86-2e60f269b1db w-inline-block"><div>Learn more</div><div class="icon-wrap_button tertiary"><div button-icon-right="" class="icon_button w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 16 16" fill="none">
  <path d="M3.33594 8.00004H12.6693M12.6693 8.00004L8.0026 3.33337M12.6693 8.00004L8.0026 12.6667" stroke="currentColor" stroke-width="var(--_❇️-icon---icon-stroke)" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div><div button-icon-right="" class="icon_button w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 16 16" fill="none">
  <path d="M3.33594 8.00004H12.6693M12.6693 8.00004L8.0026 3.33337M12.6693 8.00004L8.0026 12.6667" stroke="currentColor" stroke-width="var(--_❇️-icon---icon-stroke)" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div></div></a></div></div><div id="w-node-_99390232-2a77-1ad5-4b58-42a6265e79ea-fac9a263" class="image_feature"><img src="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69da22a3aa0d5ddab3aed0db_The%20window%20for%20Western%20producers.avif" loading="lazy" sizes="(max-width: 767px) 100vw, 576px" srcset="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69da22a3aa0d5ddab3aed0db_The%20window%20for%20Western%20producers-p-500.avif 500w, https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69da22a3aa0d5ddab3aed0db_The%20window%20for%20Western%20producers.avif 1200w" alt="Smiling family of four sitting closely together on a couch watching television, with father holding a remote control." class="image_cover"/></div></div></div></div></div></section><section class="section_how-it-works"><div class="padding-global"><div class="w-layout-blockcontainer container-large w-container"><div data-w-id="5102f56f-6830-e72b-2a75-42e76816fbf1" style="-webkit-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="headline_hiw"><div class="master_label"><div class="icon-label"></div><div class="text-size-small">Sustainability</div></div><h2 class="margin-0 text-color-black">This isn&#x27;t just about what comes out of the ground. <span class="text-color-slate">It&#x27;s about what goes back into the community.</span></h2></div><div class="w-layout-grid hiw_halves"><div class="content_hiw-column"><div class="list_hiw"><div data-w-id="409ed4dc-585e-5264-cd24-c1ec242075ba" style="-webkit-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="item_hiw"><div class="icon_tick-hiw w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none">
  <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="var(--_❇️-icon---icon-stroke)" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div><div class="text-wrap_item-hiw"><div class="text-size-large text-medium text-color-black">Real jobs, real investment</div><p class="tone-medium margin-0">Over 300 direct roles spanning nine sectors, recruited locally wherever possible, with serious investment in training and clear pathways for progression. These are careers, not contracts.</p></div></div><div data-w-id="2b3018f8-4cca-549c-ef2f-6fb60f710570" style="-webkit-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="item_hiw"><div class="icon_tick-hiw w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none">
  <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="var(--_❇️-icon---icon-stroke)" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div><div class="text-wrap_item-hiw"><div class="text-size-large text-medium text-color-black">Environmental accountability</div><p class="tone-medium margin-0">Continuous monitoring of water, dust, noise, and groundwater. A fully funded £13.2 million restoration bond. 42,000 trees being planted across the site. We&#x27;re held to a high standard, and we hold ourselves to a higher one.</p></div></div><div data-w-id="3dc6665c-78d5-1d2f-346e-abf7cec6b796" style="-webkit-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="item_hiw"><div class="icon_tick-hiw w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none">
  <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="var(--_❇️-icon---icon-stroke)" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div><div class="text-wrap_item-hiw"><div class="text-size-large text-medium text-color-black">A long-term neighbour</div><p class="tone-medium margin-0">We&#x27;ve been part of the communities around Hemerdon since 2019, and we intend to stay that way. We maintain a presence at three parish councils, support local causes, and prioritise local suppliers.</p></div></div></div><div data-w-id="7333da32-41cf-0384-fa1a-36b2ce26eda1" style="-webkit-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 50px, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0"><a href="/sustainability" button="" data-wf--cta-primary--variant="primary" class="cta_primary w-inline-block"><div class="button_text-mask"><div button-text="" class="text-button">See our commitment </div></div><div class="icon-wrap_button right"><div button-icon-right="" class="icon_button w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 12 12" fill="none">
  <path d="M2.5 6H9.5M9.5 6L6 2.5M9.5 6L6 9.5" stroke="currentColor" stroke-width="var(--_❇️-icon---icon-stroke)" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div><div button-icon-right="" class="icon_button w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 12 12" fill="none">
  <path d="M2.5 6H9.5M9.5 6L6 2.5M9.5 6L6 9.5" stroke="currentColor" stroke-width="var(--_❇️-icon---icon-stroke)" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div></div><div button-bg="" class="btn-bg"></div><div class="w-embed"><style>

  
