}
.hs-form-field .hs-form-checkbox .hs-form-checkbox-display input{
  width:auto !important;
}
.hs_error_rollup {
    display: none;
}
.hs-form-field legend.hs-field-desc {
    margin: 11px 0;
}

div#footer-3 {
