  }
  .brand-row .vc_single_image-wrapper img,
  .brand-row .product-img .vc_single_image-wrapper img {
    max-height: 70px;
  }
  .operation-section .row_inner_wrapper,
  .testimonial-section .row_inner_wrapper {
