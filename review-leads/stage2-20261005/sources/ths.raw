/* New belt style start */ .belt-wrapper>.row_inner_wrapper { margin-top: -20px; padding: 0px 0px 20px; } .inner_belt { padding: 35px; border-radius:12px; } .hydrogen-showcase-card { padding-left: 20px; padding-right: 25px; position: relative; display: flex; align-items: center; justify-content: space-between; overflow: hidden; } .belt-wrapper .wpb_column.vc_column_container.vc_col-sm-8, .belt-wrapper .wpb_column.vc_column_container.vc_col-sm-4 { padding: 0px; } .inner_belt::before { content: ""; position: absolute; left: 20px; top: 0; width: 15px; height: 100%; background: #949300; z-index: 1; border-radius: 11px 0px 0px 11px; display:block; } .inner_belt>.vc_column_container>.vc_column-inner { padding: 0; } .showcase-subtitle { display: block; color: #949300; font-size: 18px; line-height: 22px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 10px; font-family: "Bai Jamjuree", sans-serif; } .showcase-title { margin: 0; color: #fff; font-size: 32px; font-weight: 700; line-height: 1; font-family: "Bai Jamjuree", sans-serif; } .showcase-date { text-align: center; width: 200px; } .showcase-date h3 { margin: 0 0 0px; color: #fff; font-size: 22px; font-weight: 700; font-family: "Bai Jamjuree", sans-serif; } .showcase-date p { margin: 0; color: #8ea0c3; font-size: 22px; font-weight: 600; } .belt-desc p { font-style: italic; color: #8ea0c3; font-size: 16px; font-weight: 700; text-align: right; } .hero-btn.hero-btn-blue.belt-btn { width: 100% !important; text-align: right; padding-right: 20px; } @media (max-width: 991px) { .inner_belt{ flex-direction: column !important; } .hydrogen-showcase-card { flex-direction: column; align-items: flex-start; gap: 15px; } .belt-wrapper .wpb_column.vc_column_container.vc_col-sm-8, .belt-wrapper .wpb_column.vc_column_container.vc_col-sm-4 { padding: 0px; width: 100%; } .showcase-date { text-align: left; } .hero-btn.hero-btn-blue.belt-btn { width: 100% !important; text-align: left; padding-right: 20px;margin-top: 25px; margin-left: 20px; } .belt-desc p { padding-left: 20px; text-align: left; } } @media (max-width: 767px) { .showcase-title { font-size: 32px; } .showcase-date { text-align: left; } .showcase-date p { font-size: 18px; } }
