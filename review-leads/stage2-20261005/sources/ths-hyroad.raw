in-top: 25px; margin-left: 20px; } .belt-desc p { padding-left: 20px; text-align: left; } } @media (max-width: 767px) { .showcase-title { font-size: 32px; } .showcase-date { text-align: left; } .showcase-date p { font-size: 18px; } }
