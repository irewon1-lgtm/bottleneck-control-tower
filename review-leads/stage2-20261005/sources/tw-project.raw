e_footer-expand vertical"></div><div class="line_footer-expand horizontal"></div></div></div><div class="wrap_column-footer"><div class="column_footer-links"><div class="iframe w-embed w-iframe"><iframe src="https://irtools.co.uk/tools/share_price/08688281-7ef0-46a5-89ab-1dec6bb31929"></iframe></div></div></div></div></div></div></div></div><div class="footer_bottom"><div class="padding-global"><div class="w-layout-blockcontainer container-large w-container"><div data-w-id="c4544122-2b26-130c-b84b-0001661845df" class="footer_bottom-halves"><div data-w-id="c4544122-2b26-130c-b84b-0001661845e0" class="footer_bottom-left"><p class="text-size-small tone-medium">Tungsten West Plc is a mining development company focused on restarting the world-class Hemerdon tungsten mine on the outskirts of Plymouth.<br/>The company is the 100% owner of the Hemerdon Mine, which is one of the largest tungsten resources in the world.</p></div><div data-w-id="c4544122-2b26-130c-b84b-0001661845e3" class="footer_bottom-right"><div class="text-size-small tone-subtle">© Tungsten West <span fs-hacks-element="year">20xx</span></div><div class="footer_legal"><a href="/policies" class="link_footer-legal">Policies</a><a href="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/69e25f2f885db8a557dc4cff_TungstenWest_Privacy_Notice.pdf" target="_blank" class="link_footer-legal">Privacy Policy</a></div><div class="text-size-small">Designed by <a href="https://www.gforce.studio/" target="_blank" class="link_footer-legal">G-Force</a></div></div></div></div></div></div></div></section></div><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=69d6c3ce43485ab7fac9a1df" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/js/webflow.schunk.36b8fb49256177c8.js" type="text/javascript" integrity="sha384-4abIlA5/v7XaW1HMXKBgnUuhnjBYJ/Z9C1OSg4OhmVw9O3QeHJ/qJqFBERCDPv7G" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/js/webflow.schunk.4df87652dcd3e412.js" type="text/javascript" integrity="sha384-FLot0lTywKPYSdSbDU6wdSJ+aLuMrfTYO4qqIFUyPBnvI99N8Jb0uAqGRg0gw6yP" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/js/webflow.schunk.cce306f7fd629ddb.js" type="text/javascript" integrity="sha384-IwqIephGnG67y7YvKqqQ+t++WBcjACr36OdYge9vn24ZcEbgr0dJvakQJxuYw6cW" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/69d6c3ce43485ab7fac9a1df/js/webflow.dc657a8d.f04b45af64a2ba48.js" type="text/javascript" integrity="sha384-6jhEp98FlXo8XPpcvyQHTyNqsiYD+QawzYAJlAupOblkITHS4DgW9QPWFmere1gK" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/gsap.min.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/Flip.min.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/ScrollTrigger.min.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/SplitText.min.js" type="text/javascript"></script><script type="text/javascript">gsap.registerPlugin(Flip,ScrollTrigger,SplitText);</script><script>

document.addEventListener('DOMContentLoaded', function() {
  // Register ScrollTrigger plugin
  gsap.registerPlugin(ScrollTrigger);
  
  // Find all elements with the data-count-to attribute
  const countElements = document.querySelectorAll('[data-count-to]');
  
  countElements.forEach(element => {
    // Get custom attributes from the element
    const targetNumber = parseFloat(element.getAttribute('data-count-to')) || 100;
    const duration = parseFloat(element.getAttribute('data-duration')) || 2;
    const delay = parseFloat(element.getAttribute('data-delay')) || 0;
    const decimals = parseInt(element.getAttribute('data-decimals')) || 0;
    
    // Set initial value
    element.textContent = '0';
    
    // Create counter object
    const counter = { value: 0 };
    
    // Animate the counter with ScrollTrigger
    gsap.to(counter, {
      value: targetNumber,
      duration: duration,
      delay: delay,
      ease: 'power1.out',
      scrollTrigger: {
        trigger: element,
        start: 'top 80%',
        toggleActions: 'play none none none',
        once: true
      },
      onUpdate: function() {
        element.textContent = counter.value.toFixed(decimals);
      }
    });
  });
});
</script>


<script>
document.addEventListener('DOMContentLoaded', () => {
  const elements = document.querySelectorAll('[fs-hacks-element="year"]');
  const year = new Date().getFullYear();

  elements.forEach(el => {
    el.textContent = year;
  });
});
</script>

<script>
window.addEventListener('message', function(event) {

  var frames = document.getElementsByTagName('iframe');

  for (var i = 0; i < frames.length; i++) {

    if (frames[i].contentWindow === event.source) {

      var style = frames[i].currentStyle || window.getComputedStyle(frames[i]);

      var paddingTop = parseInt(style.paddingTop || 0);
      var paddingBottom = parseInt(style.paddingBottom || 0);

      var padding = paddingTop + paddingBottom;

      frames[i].style.height = event.data + padding + 'px';

      break;
    }
  }

});
</script></body></html>