    "origin_id": "https://www.biospace.com/business/with-mfn-now-embedded-in-pharma-execs-see-little-impact-from-democrats-blue-wave/#article",
    "canonical_url": "https://www.biospace.com/business/with-mfn-now-embedded-in-pharma-execs-see-little-impact-from-democrats-blue-wave",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-04T13:33:26.085000+00:00",
