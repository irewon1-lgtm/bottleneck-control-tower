    "canonical_url": "https://www.defensenews.com/industry/techwatch/2026/10/13/bae-systems-unveils-new-layered-air-defense-system/",
    "origin_publisher": "Defense News",
    "published_at": "2026-10-13T20:15:00+00:00",
