    "origin_id": "https://breakingdefense.com/2026/11/saildrone-inks-agreement-with-norwegian-shipbuilder-umoe-mandal-to-produce-usvs/",
    "canonical_url": "https://breakingdefense.com/2026/11/saildrone-inks-agreement-with-norwegian-shipbuilder-umoe-mandal-to-produce-usvs/",
    "origin_publisher": "Breaking Defense",
    "published_at": "2026-11-05T17:23:00+00:00",
