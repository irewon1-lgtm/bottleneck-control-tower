    "collected_at": "2026-11-10T22:57:40.207197+00:00",
    "origin_id": "https://electrek.co/2026/11/10/kia-launches-two-new-pv5-electric-van-variants-uk/",
    "canonical_url": "https://electrek.co/2026/11/10/kia-launches-two-new-pv5-electric-van-variants-uk/",
    "origin_publisher": "Electrek",
    "published_at": "2026-11-10T22:29:08+00:00",
    "published_at_raw": "2026-11-10T22:29:08+00:00",
