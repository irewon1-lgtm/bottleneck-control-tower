    "canonical_url": "https://www.autoevolution.com/news/maserati-to-unveil-concepts-previewing-the-next-levante-and-quattroporte-in-december-2026-278183.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-09T19:57:24+00:00",
