    "canonical_url": "https://www.biospace.com/drug-development/gsk-ionis-hepatitis-b-functional-cure-breaks-open-market-for-followers",
    "origin_publisher": "BioSpace",
    "published_at": "2026-10-22T13:49:34.293000+00:00",
