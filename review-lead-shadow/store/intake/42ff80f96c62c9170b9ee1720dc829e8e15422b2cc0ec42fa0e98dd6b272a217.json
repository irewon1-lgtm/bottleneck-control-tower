    "origin_id": "https://www.freightwaves.com/news/opinion-how-politics-and-policy-are-rewriting-the-rules-of-parcel-delivery",
    "canonical_url": "https://www.freightwaves.com/news/opinion-how-politics-and-policy-are-rewriting-the-rules-of-parcel-delivery",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-10-15T13:59:56+00:00",
    "published_at_raw": "2026-10-15T13:59:56+00:00",
