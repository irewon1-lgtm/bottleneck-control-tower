    "origin_id": "https://www.autoevolution.com/news/november-mini-gt-preorder-reveals-six-fast-cars-one-of-them-is-a-new-casting-278178.html",
    "canonical_url": "https://www.autoevolution.com/news/november-mini-gt-preorder-reveals-six-fast-cars-one-of-them-is-a-new-casting-278178.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-09T18:26:40+00:00",
    "published_at_raw": "2026-11-09T18:26:40+0000",
