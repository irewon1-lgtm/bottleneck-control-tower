    "canonical_url": "https://www.autoevolution.com/news/new-matchbox-collector-series-cars-for-2027-is-it-time-to-lose-hope-277928.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-03T20:30:47+00:00",
