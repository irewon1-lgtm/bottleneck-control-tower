    "canonical_url": "https://www.northernminer.com/news/mineros-gold-bet-raises-cash-and-collateral-risks/1003897790/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-11-13T18:00:49+00:00",
    "published_at_raw": "2026-11-13T18:00:49+00:00",
    "publication_precision": "TIMESTAMP",
