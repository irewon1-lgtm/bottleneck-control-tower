    "canonical_url": "https://www.northernminer.com/news/gold-mountain-targets-wwii-tungsten-mine-in-brazil/1003895571/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-10-08T15:03:00+00:00",
    "published_at_raw": "2026-10-08T15:03:00+00:00",
    "publication_precision": "TIMESTAMP",
