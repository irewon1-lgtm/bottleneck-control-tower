    "origin_id": "https://www.freightwaves.com/news/asia-us-container-rates-hold-as-carriers-seek-3000-november-rate-hikes",
    "canonical_url": "https://www.freightwaves.com/news/asia-us-container-rates-hold-as-carriers-seek-3000-november-rate-hikes",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-11-04T17:39:26+00:00",
    "published_at_raw": "2026-11-04T17:39:26+00:00",
    "publication_precision": "TIMESTAMP",
