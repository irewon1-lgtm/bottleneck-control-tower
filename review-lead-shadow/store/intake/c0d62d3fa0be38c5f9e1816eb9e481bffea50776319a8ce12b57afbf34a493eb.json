    "origin_id": "https://www.northernminer.com/news/asante-eyes-bibiani-savings-after-guidance-retreat/1003897842/#article",
    "canonical_url": "https://www.northernminer.com/news/asante-eyes-bibiani-savings-after-guidance-retreat/1003897842/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-11-16T21:20:23+00:00",
    "published_at_raw": "2026-11-16T21:20:23+00:00",
    "publication_precision": "TIMESTAMP",
