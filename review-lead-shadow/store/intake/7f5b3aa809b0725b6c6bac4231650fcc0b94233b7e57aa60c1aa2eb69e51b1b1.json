    "canonical_url": "https://www.autoevolution.com/news/court-bans-byd-from-selling-its-land-rover-defender-copycat-in-europe-278772.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-21T22:00:01+00:00",
