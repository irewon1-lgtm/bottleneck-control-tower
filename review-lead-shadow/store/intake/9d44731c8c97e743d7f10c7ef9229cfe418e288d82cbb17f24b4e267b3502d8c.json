    "origin_id": "https://www.northernminer.com/news/agnico-spends-early-to-curb-mine-cost-blowouts/1003897579/#article",
    "canonical_url": "https://www.northernminer.com/news/agnico-spends-early-to-curb-mine-cost-blowouts/1003897579/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-11-09T22:05:53+00:00",
