    "canonical_url": "https://breakingdefense.com/2026/11/fairbanks-morse-defense-in-talks-with-navy-about-seawolf-class-submarine-repairs/",
    "origin_publisher": "Breaking Defense",
    "published_at": "2026-11-05T17:00:00+00:00",
