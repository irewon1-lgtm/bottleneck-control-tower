    "collected_at": "2026-10-30T16:27:12.405133+00:00",
    "origin_id": "https://www.biospace.com/business/regeneron-achieves-clean-sweep-in-q3-with-myriad-pipeline-catalysts-on-deck/#article",
    "canonical_url": "https://www.biospace.com/business/regeneron-achieves-clean-sweep-in-q3-with-myriad-pipeline-catalysts-on-deck",
    "origin_publisher": "BioSpace",
    "published_at": "2026-10-30T15:07:04.184000+00:00",
