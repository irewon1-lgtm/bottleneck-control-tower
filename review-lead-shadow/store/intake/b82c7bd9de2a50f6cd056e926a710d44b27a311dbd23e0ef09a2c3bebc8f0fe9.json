    "origin_id": "https://www.biospace.com/drug-development/obesityweek-2026-wave-outlines-case-for-body-composition-based-trial-design/#article",
    "canonical_url": "https://www.biospace.com/drug-development/obesityweek-2026-wave-outlines-case-for-body-composition-based-trial-design",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-16T14:35:21.038000+00:00",
    "published_at_raw": "2026-11-16T14:35:21.038Z",
    "publication_precision": "TIMESTAMP",
