  "source_document": {
    "document_id": "6d878188-3cde-4d6f-bcd1-8cfc23468f4e",
    "origin_url": "https://electrek.co/2026/11/05/segway-launches-new-electric-motorcycle-thats-so-safe-it-has-seatbelts/",
    "collected_at": "2026-11-05T17:50:29.122415+00:00",
    "origin_id": "https://electrek.co/2026/11/05/segway-launches-new-electric-motorcycle-thats-so-safe-it-has-seatbelts/",
    "canonical_url": "https://electrek.co/2026/11/05/segway-launches-new-electric-motorcycle-thats-so-safe-it-has-seatbelts/",
    "origin_publisher": "Electrek",
    "published_at": "2026-11-05T17:13:27+00:00",
    "published_at_raw": "2026-11-05T17:13:27+00:00",
