    "canonical_url": "https://www.freightwaves.com/news/worlds-first-ammonia-powered-dry-bulk-ship-completes-sea-trials",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-10-20T16:30:00+00:00",
