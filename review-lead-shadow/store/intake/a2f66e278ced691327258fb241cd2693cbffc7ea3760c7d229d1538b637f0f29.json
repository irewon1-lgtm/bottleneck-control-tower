    "collected_at": "2026-11-10T17:27:08.791686+00:00",
    "origin_id": "https://www.biospace.com/business/delix-raises-100m-to-advance-at-home-psychedelic-without-hallucinogenic-effects/#article",
    "canonical_url": "https://www.biospace.com/business/delix-raises-100m-to-advance-at-home-psychedelic-without-hallucinogenic-effects",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-10T14:26:23.080000+00:00",
    "published_at_raw": "2026-11-10T14:26:23.080Z",
    "publication_precision": "TIMESTAMP",
    "acquired_at": "2026-11-10T17:40:24.374658+00:00",
