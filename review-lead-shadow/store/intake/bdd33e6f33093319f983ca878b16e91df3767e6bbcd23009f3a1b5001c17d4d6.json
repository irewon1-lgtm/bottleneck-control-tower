    "origin_id": "https://electrek.co/2026/10/22/tesla-building-own-maps-fsd-after-mocking-maps/",
    "canonical_url": "https://electrek.co/2026/10/22/tesla-building-own-maps-fsd-after-mocking-maps/",
    "origin_publisher": "Electrek",
    "published_at": "2026-10-22T20:03:18+00:00",
    "published_at_raw": "2026-10-22T20:03:18+00:00",
