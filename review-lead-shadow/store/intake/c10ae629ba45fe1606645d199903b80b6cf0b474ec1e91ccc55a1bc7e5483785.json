    "canonical_url": "https://www.autoevolution.com/news/erevs-may-dodge-eu-hybrid-caps-but-still-face-bev-tariffs-278862.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-23T15:07:47+00:00",
