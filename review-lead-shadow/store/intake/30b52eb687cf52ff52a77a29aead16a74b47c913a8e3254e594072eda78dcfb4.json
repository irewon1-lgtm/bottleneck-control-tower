    "origin_id": "https://www.biospace.com/drug-development/summits-pd-1xvegf-rejected-by-fda-in-lung-cancer/#article",
    "canonical_url": "https://www.biospace.com/drug-development/summits-pd-1xvegf-rejected-by-fda-in-lung-cancer",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-15T14:03:30.784000+00:00",
    "published_at_raw": "2026-11-15T14:03:30.784Z",
    "publication_precision": "TIMESTAMP",
