    "canonical_url": "https://breakingdefense.com/2026/10/navy-awards-applied-intuition-25m-to-deploy-ai-sensor-fusion-at-sea/",
    "origin_publisher": "Breaking Defense",
    "published_at": "2026-10-22T15:43:21+00:00",
