    "origin_id": "https://www.freightwaves.com/news/einride-nvidia-alpamayo-autonomous-trucks",
    "canonical_url": "https://www.freightwaves.com/news/einride-nvidia-alpamayo-autonomous-trucks",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-10-22T12:00:00+00:00",
    "published_at_raw": "2026-10-22T12:00:00+00:00",
    "publication_precision": "TIMESTAMP",
