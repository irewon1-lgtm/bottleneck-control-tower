    "origin_id": "https://www.freightwaves.com/news/insurance-claims-adjustments-tank-landstars-otherwise-strong-q3",
    "canonical_url": "https://www.freightwaves.com/news/insurance-claims-adjustments-tank-landstars-otherwise-strong-q3",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-10-28T03:22:42+00:00",
    "published_at_raw": "2026-10-28T03:22:42+00:00",
    "publication_precision": "TIMESTAMP",
