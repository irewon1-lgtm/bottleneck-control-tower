    "canonical_url": "https://www.defensenews.com/global/asia-pacific/2026/10/19/australia-gets-the-ball-rolling-on-medium-range-air-defense/",
    "origin_publisher": "Defense News",
    "published_at": "2026-10-19T11:32:17.561000+00:00",
