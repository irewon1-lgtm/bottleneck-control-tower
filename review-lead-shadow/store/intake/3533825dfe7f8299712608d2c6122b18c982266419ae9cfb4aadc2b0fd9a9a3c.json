    "canonical_url": "https://www.autoevolution.com/news/you-ve-probably-never-seen-anything-like-this-immensely-powerful-audi-rs-3-sedan-have-you-video-277626.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-31T10:06:01+00:00",
