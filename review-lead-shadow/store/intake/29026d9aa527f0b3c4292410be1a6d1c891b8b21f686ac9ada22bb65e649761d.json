    "origin_id": "https://www.northernminer.com/regulatory-issues/sponsored-qa-with-srk-video-stuart-smith-on-minings-shift-from-build-to-buy/1003898102/#article",
    "canonical_url": "https://www.northernminer.com/regulatory-issues/sponsored-qa-with-srk-video-stuart-smith-on-minings-shift-from-build-to-buy/1003898102/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-11-20T15:01:23+00:00",
    "published_at_raw": "2026-11-20T15:01:23+00:00",
    "publication_precision": "TIMESTAMP",
