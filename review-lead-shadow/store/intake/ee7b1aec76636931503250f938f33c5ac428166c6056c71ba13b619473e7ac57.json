    "origin_id": "https://www.biospace.com/deals/china-tightens-grip-on-biotech-platform-ownership-but-foreign-licensing-deals-still-okay/#article",
    "canonical_url": "https://www.biospace.com/deals/china-tightens-grip-on-biotech-platform-ownership-but-foreign-licensing-deals-still-okay",
    "origin_publisher": "BioSpace",
    "published_at": "2026-10-19T13:57:01.907000+00:00",
    "published_at_raw": "2026-10-19T13:57:01.907Z",
    "publication_precision": "TIMESTAMP",
