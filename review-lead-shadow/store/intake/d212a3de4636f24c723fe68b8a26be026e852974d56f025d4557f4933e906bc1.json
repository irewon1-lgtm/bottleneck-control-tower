    "canonical_url": "https://www.autoevolution.com/news/2027-gmc-sierra-hd-drops-a-555-hp-new-duramax-v8-under-its-hood-it-ll-set-you-back-at-least-68k-278817.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-23T08:07:49+00:00",
