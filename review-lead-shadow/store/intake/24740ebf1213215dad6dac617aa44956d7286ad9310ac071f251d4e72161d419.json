    "canonical_url": "https://www.freightwaves.com/news/lufthansa-cargo-to-buy-out-2nd-ground-agent-at-frankfurt-airport",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-11-23T17:32:21+00:00",
