    "origin_id": "https://www.freightwaves.com/news/ceos-letter-boasts-of-lots-of-arrows-pointing-up-at-triumph-financial",
    "canonical_url": "https://www.freightwaves.com/news/ceos-letter-boasts-of-lots-of-arrows-pointing-up-at-triumph-financial",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-10-21T23:29:46+00:00",
