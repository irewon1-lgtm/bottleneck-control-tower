    "canonical_url": "https://www.biospace.com/drug-development/alnylam-plans-pivotal-trial-as-huntingtons-drug-notches-best-in-class-knockdown",
    "origin_publisher": "BioSpace",
    "published_at": "2026-10-23T15:27:30.297000+00:00",
