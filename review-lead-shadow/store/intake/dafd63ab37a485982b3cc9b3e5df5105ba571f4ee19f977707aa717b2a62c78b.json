    "collected_at": "2026-11-19T09:58:34.102743+00:00",
    "origin_id": "https://www.biospace.com/business/abbvie-grooves-with-discos-solid-tumor-tech-in-up-to-2-5b-licensing-deal/#article",
    "canonical_url": "https://www.biospace.com/business/abbvie-grooves-with-discos-solid-tumor-tech-in-up-to-2-5b-licensing-deal",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-19T07:02:00+00:00",
    "published_at_raw": "2026-11-19T07:02:00.000Z",
    "publication_precision": "TIMESTAMP",
