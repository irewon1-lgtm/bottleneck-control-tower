    "canonical_url": "https://www.biospace.com/j-js-innovative-medicines-carried-q3-as-medtech-disappoints-but-newer-medicines-absent",
    "origin_publisher": "BioSpace",
    "published_at": "2026-10-13T15:20:01.123000+00:00",
