    "origin_id": "https://www.biospace.com/deals/opinion-how-abogen-went-from-covid-hype-to-a-7-8b-novartis-deal/#article",
    "canonical_url": "https://www.biospace.com/deals/opinion-how-abogen-went-from-covid-hype-to-a-7-8b-novartis-deal",
    "origin_publisher": "BioSpace",
    "published_at": "2026-10-09T11:54:09.543000+00:00",
