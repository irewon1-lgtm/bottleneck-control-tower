    "canonical_url": "https://www.autoevolution.com/news/for-true-outdoor-lovers-intech-s-tiny-2027-flyer-explore-toy-hauler-doesn-t-sacrifice-garage-space-278741.html",
    "origin_publisher": "autoevolution",
