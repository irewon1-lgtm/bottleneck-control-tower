    "origin_id": "https://www.biospace.com/business/bms-drops-prothena-partnered-neuro-drug-sales-outlook-improves-on-a-q3-beat/#article",
    "canonical_url": "https://www.biospace.com/business/bms-drops-prothena-partnered-neuro-drug-sales-outlook-improves-on-a-q3-beat",
    "origin_publisher": "BioSpace",
    "published_at": "2026-10-29T15:47:53.229000+00:00",
