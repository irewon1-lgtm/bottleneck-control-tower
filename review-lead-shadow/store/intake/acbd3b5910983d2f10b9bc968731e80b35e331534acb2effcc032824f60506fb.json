    "canonical_url": "https://www.biospace.com/drug-delivery/pharming-pauses-ruconest-production-over-fill-finish-issue-threatening-us-supply",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-25T15:18:38.166000+00:00",
