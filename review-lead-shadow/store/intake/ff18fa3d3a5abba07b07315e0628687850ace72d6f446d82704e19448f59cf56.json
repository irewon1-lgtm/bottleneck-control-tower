    "origin_id": "https://www.biospace.com/drug-development/serious-adverse-events-mar-robust-efficacy-data-for-helus-psychedelic-in-major-depression/#article",
    "canonical_url": "https://www.biospace.com/drug-development/serious-adverse-events-mar-robust-efficacy-data-for-helus-psychedelic-in-major-depression",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-16T15:50:46.940000+00:00",
    "published_at_raw": "2026-11-16T15:50:46.940Z",
