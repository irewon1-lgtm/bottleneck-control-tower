    "origin_id": "https://breakingdefense.com/2026/10/hanwha-sets-sights-on-armys-tracked-howitzer-program-after-victory-in-wheeled-competition/",
    "canonical_url": "https://breakingdefense.com/2026/10/hanwha-sets-sights-on-armys-tracked-howitzer-program-after-victory-in-wheeled-competition/",
    "origin_publisher": "Breaking Defense",
    "published_at": "2026-10-09T14:09:00+00:00",
