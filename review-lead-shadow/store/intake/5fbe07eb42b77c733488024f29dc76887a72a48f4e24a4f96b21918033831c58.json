    "origin_id": "https://breakingdefense.com/2026/10/hegseth-uses-ausa-spotlight-to-highlight-autonomy-generational-defense-investment/",
    "canonical_url": "https://breakingdefense.com/2026/10/hegseth-uses-ausa-spotlight-to-highlight-autonomy-generational-defense-investment/",
    "origin_publisher": "Breaking Defense",
    "published_at": "2026-10-14T16:47:00+00:00",
