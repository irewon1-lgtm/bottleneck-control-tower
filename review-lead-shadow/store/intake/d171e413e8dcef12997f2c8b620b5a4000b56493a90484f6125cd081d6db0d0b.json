    "origin_id": "https://electrek.co/2026/11/07/tesla-solar-roof-fraud-liable-experiment-lawsuit/",
    "canonical_url": "https://electrek.co/2026/11/07/tesla-solar-roof-fraud-liable-experiment-lawsuit/",
    "origin_publisher": "Electrek",
    "published_at": "2026-11-07T16:01:23+00:00",
