    "canonical_url": "https://www.northernminer.com/news/aris-extends-toroparu-gold-plan-as-cost-climbs-36/1003897775/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-11-13T15:20:29+00:00",
    "published_at_raw": "2026-11-13T15:20:29+00:00",
    "publication_precision": "TIMESTAMP",
