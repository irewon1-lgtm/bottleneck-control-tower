    "canonical_url": "https://www.northernminer.com/news/i-80-golds-growth-faces-nevada-labour-squeeze/1003897350/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-11-03T16:11:04+00:00",
    "published_at_raw": "2026-11-03T16:11:04+00:00",
    "publication_precision": "TIMESTAMP",
