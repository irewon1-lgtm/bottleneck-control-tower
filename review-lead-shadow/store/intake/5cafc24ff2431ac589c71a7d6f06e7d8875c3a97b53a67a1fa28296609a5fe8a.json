    "collected_at": "2026-10-13T09:04:15.858155+00:00",
    "origin_id": "https://www.supplychain247.com/article/port-los-angeles-september-cargo-record",
    "canonical_url": "https://www.supplychain247.com/article/port-los-angeles-september-cargo-record",
    "origin_publisher": "Supply Chain 24/7",
    "published_at": "2026-10-13T01:22:00-04:00",
    "published_at_raw": "2026-10-13T01:22:00-04:00",
