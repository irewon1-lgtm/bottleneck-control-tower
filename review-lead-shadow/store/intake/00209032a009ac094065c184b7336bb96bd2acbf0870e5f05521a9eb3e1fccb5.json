    "canonical_url": "https://www.autoevolution.com/news/tomplan-does-toy-hauler-campers-differently-composite-midi-cargo-xl-weighs-as-little-as-772-lbs-277104.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-15T18:12:32+00:00",
