    "collected_at": "2026-11-26T19:23:59.989465+00:00",
    "origin_id": "https://www.northernminer.com/news/planet-one-leads-933m-plan-for-senegal-iron-ore/1003898303/#article",
    "canonical_url": "https://www.northernminer.com/news/planet-one-leads-933m-plan-for-senegal-iron-ore/1003898303/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-11-26T14:33:06+00:00",
    "published_at_raw": "2026-11-26T14:33:06+00:00",
