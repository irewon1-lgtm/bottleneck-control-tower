    "origin_id": "https://theloadstar.com/how-accurate-load-measurement-prevents-tarp-strap-and-permit-errors/#article",
    "canonical_url": "https://theloadstar.com/how-accurate-load-measurement-prevents-tarp-strap-and-permit-errors/",
    "origin_publisher": "The Loadstar",
    "published_at": "2026-10-29T00:01:43+00:00",
