    "collected_at": "2026-11-20T21:39:39.845040+00:00",
    "origin_id": "https://www.northernminer.com/news/miners-drill-more-but-raise-28-less-money/1003898112/#article",
    "canonical_url": "https://www.northernminer.com/news/miners-drill-more-but-raise-28-less-money/1003898112/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-11-20T15:20:43+00:00",
