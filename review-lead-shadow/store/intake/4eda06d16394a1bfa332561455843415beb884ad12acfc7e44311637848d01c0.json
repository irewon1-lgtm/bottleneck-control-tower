    "canonical_url": "https://www.autoevolution.com/news/new-gas-turbine-will-keep-ai-cool-before-it-gets-to-power-supersonic-passenger-plane-278159.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-09T12:41:13+00:00",
