    "origin_id": "https://www.northernminer.com/news/barrick-files-for-ipo-with-1-25b-dividend-plan/1003897675/#article",
    "canonical_url": "https://www.northernminer.com/news/barrick-files-for-ipo-with-1-25b-dividend-plan/1003897675/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-11-11T14:55:20+00:00",
    "published_at_raw": "2026-11-11T14:55:20+00:00",
