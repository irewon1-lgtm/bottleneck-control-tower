    "collected_at": "2026-11-19T18:47:24.600192+00:00",
    "origin_id": "https://electrek.co/2026/11/19/byd-folding-steering-wheel-tai-9-production/",
    "canonical_url": "https://electrek.co/2026/11/19/byd-folding-steering-wheel-tai-9-production/",
    "origin_publisher": "Electrek",
    "published_at": "2026-11-19T16:24:52+00:00",
    "published_at_raw": "2026-11-19T16:24:52+00:00",
