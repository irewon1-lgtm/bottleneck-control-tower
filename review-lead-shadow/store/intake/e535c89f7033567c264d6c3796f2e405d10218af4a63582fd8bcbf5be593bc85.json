    "collected_at": "2026-10-30T16:27:12.407730+00:00",
    "origin_id": "https://www.biospace.com/business/sanofi-targets-late-phase-and-commercial-m-a-to-offset-looming-dupixent-decline/#article",
    "canonical_url": "https://www.biospace.com/business/sanofi-targets-late-phase-and-commercial-m-a-to-offset-looming-dupixent-decline",
    "origin_publisher": "BioSpace",
    "published_at": "2026-10-30T15:03:13.937000+00:00",
    "published_at_raw": "2026-10-30T15:03:13.937Z",
