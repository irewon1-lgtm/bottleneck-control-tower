    "collected_at": "2026-11-16T19:58:48.171412+00:00",
    "origin_id": "https://www.northernminer.com/news/giant-diamonds-lift-lucaras-revenue-outlook/1003897855/#article",
    "canonical_url": "https://www.northernminer.com/news/giant-diamonds-lift-lucaras-revenue-outlook/1003897855/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-11-16T17:15:00+00:00",
