    "collected_at": "2026-11-02T09:01:06.042197+00:00",
    "origin_id": "https://www.biospace.com/drug-development/can-saudi-arabias-burgeoning-biotech-hub-withstand-geopolitical-pressures/#article",
    "canonical_url": "https://www.biospace.com/drug-development/can-saudi-arabias-burgeoning-biotech-hub-withstand-geopolitical-pressures",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-02T06:01:00+00:00",
    "published_at_raw": "2026-11-02T06:01:00.000Z",
