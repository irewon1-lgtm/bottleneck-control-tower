    "canonical_url": "https://www.freightwaves.com/news/werner-enterprises-sees-cost-headwinds-lingering-into-q1",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-10-28T00:10:03+00:00",
    "published_at_raw": "2026-10-28T00:10:03+00:00",
    "publication_precision": "TIMESTAMP",
