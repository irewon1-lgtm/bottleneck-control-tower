    "collected_at": "2026-11-19T18:47:07.746585+00:00",
    "origin_id": "https://www.freightwaves.com/news/vantage-9-supply-chain-software-go-live",
    "canonical_url": "https://www.freightwaves.com/news/vantage-9-supply-chain-software-go-live",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-11-19T18:06:55+00:00",
    "published_at_raw": "2026-11-19T18:06:55+00:00",
