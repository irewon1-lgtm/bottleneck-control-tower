    "canonical_url": "https://www.freightwaves.com/news/diesel-price-declines-picking-up-pace",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-11-24T21:49:41+00:00",
    "published_at_raw": "2026-11-24T21:49:41+00:00",
    "publication_precision": "TIMESTAMP",
