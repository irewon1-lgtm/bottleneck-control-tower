    "origin_id": "https://breakingdefense.com/2026/11/beyond-the-cmmc-pause-protecting-the-engineering-data-defense-programs-depend-on/",
    "canonical_url": "https://breakingdefense.com/2026/11/beyond-the-cmmc-pause-protecting-the-engineering-data-defense-programs-depend-on/",
    "origin_publisher": "Breaking Defense",
    "published_at": "2026-11-10T19:39:29+00:00",
    "published_at_raw": "2026-11-10T19:39:29+00:00",
    "publication_precision": "TIMESTAMP",
