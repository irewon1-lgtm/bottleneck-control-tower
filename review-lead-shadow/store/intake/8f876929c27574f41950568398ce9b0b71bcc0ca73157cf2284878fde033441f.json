    "collected_at": "2026-11-02T19:56:36.765978+00:00",
    "origin_id": "https://www.freightwaves.com/news/trashlab-raises-12m-ai-waste-haulers",
    "canonical_url": "https://www.freightwaves.com/news/trashlab-raises-12m-ai-waste-haulers",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-11-02T16:11:32+00:00",
    "published_at_raw": "2026-11-02T16:11:32+00:00",
