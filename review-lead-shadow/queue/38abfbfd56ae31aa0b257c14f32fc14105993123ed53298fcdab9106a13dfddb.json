    "canonical_url": "https://www.autoevolution.com/news/2027-ford-bronco-hit-with-less-welcome-equipment-changes-27l-ecoboost-v6-dropped-entirely-277030.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-14T16:01:33+00:00",
