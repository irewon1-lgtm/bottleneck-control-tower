    "canonical_url": "https://www.autoevolution.com/news/1975-hurst-olds-is-dressed-to-impress-packs-w30-power-277299.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-20T20:07:57+00:00",
    "published_at_raw": "2026-10-20T20:07:57+0000",
    "publication_precision": "TIMESTAMP",
