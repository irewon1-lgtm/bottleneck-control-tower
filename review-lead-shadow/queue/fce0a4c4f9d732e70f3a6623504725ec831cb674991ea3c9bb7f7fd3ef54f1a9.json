    "canonical_url": "https://www.biospace.com/business/lillys-15th-m-a-deal-of-2026-brings-loqus23s-huntingtons-work-in-house-for-725m",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-23T13:59:56.332000+00:00",
