    "collected_at": "2026-11-05T17:50:34.367087+00:00",
    "origin_id": "https://www.biospace.com/drug-development/t-time-british-biotech-pours-133m-into-the-pot-for-bispecifics/#article",
    "canonical_url": "https://www.biospace.com/drug-development/t-time-british-biotech-pours-133m-into-the-pot-for-bispecifics",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-05T15:01:20.656000+00:00",
