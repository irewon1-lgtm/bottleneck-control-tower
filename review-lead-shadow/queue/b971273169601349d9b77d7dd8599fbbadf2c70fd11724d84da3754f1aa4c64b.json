    "canonical_url": "https://www.autoevolution.com/news/the-eu-s-new-chinese-hybrid-vehicle-import-quota-kicks-off-at-350000-vehicles-per-year-276915.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-12T16:17:13+00:00",
