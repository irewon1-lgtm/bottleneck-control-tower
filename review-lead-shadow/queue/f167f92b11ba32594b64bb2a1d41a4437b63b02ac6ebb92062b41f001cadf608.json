    "canonical_url": "https://www.autoevolution.com/news/forgotten-1966-dodge-charger-is-a-sad-sight-nice-surprise-inside-the-cabin-277037.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-14T17:41:25+00:00",
