    "canonical_url": "https://www.autoevolution.com/news/xiaomi-appears-to-have-run-out-of-steam-despite-promising-skynomad-sales-in-october-278322.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-12T12:43:27+00:00",
