    "canonical_url": "https://www.autoevolution.com/news/someone-paid-23-million-for-a-ferrari-daytona-sp3-drove-80-miles-sold-for-185-million-277922.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-03T22:00:01+00:00",
    "published_at_raw": "2026-11-03T22:00:01+0000",
