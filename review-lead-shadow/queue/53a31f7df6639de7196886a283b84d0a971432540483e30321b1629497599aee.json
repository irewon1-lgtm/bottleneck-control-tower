    "origin_id": "https://www.autoevolution.com/news/suzuki-backed-japanese-evtol-gears-up-for-commercial-service-in-south-korea-278119.html",
    "canonical_url": "https://www.autoevolution.com/news/suzuki-backed-japanese-evtol-gears-up-for-commercial-service-in-south-korea-278119.html",
    "origin_publisher": "autoevolution",
