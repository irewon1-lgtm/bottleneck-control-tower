    "canonical_url": "https://www.biospace.com/drug-development/merck-kelun-adc-scores-survival-win-in-phase-3-gastroesophageal-cancer-trial",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-20T14:33:19.623000+00:00",
