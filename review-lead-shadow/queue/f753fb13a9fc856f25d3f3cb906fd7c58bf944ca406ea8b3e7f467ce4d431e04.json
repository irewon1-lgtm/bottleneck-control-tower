    "canonical_url": "https://www.autoevolution.com/news/audi-will-build-a-new-generation-a8-after-all-this-is-why-it-might-not-make-it-to-the-us-278748.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-20T22:11:44+00:00",
    "published_at_raw": "2026-11-20T22:11:44+0000",
