    "origin_id": "https://electrek.co/2026/10/28/volkswagens-ev-battery-recall-reaches-over-85000-with-audi/",
    "canonical_url": "https://electrek.co/2026/10/28/volkswagens-ev-battery-recall-reaches-over-85000-with-audi/",
    "origin_publisher": "Electrek",
    "published_at": "2026-10-28T18:09:59+00:00",
    "published_at_raw": "2026-10-28T18:09:59+00:00",
