    "canonical_url": "https://theloadstar.com/containership-charter-rates-at-a-four-year-high-despite-record-orderbook/",
    "origin_publisher": "The Loadstar",
    "published_at": "2026-10-23T10:42:40+00:00",
    "published_at_raw": "2026-10-23T10:42:40+00:00",
