    "canonical_url": "https://www.autoevolution.com/news/this-explorer-superyacht-is-equipped-for-any-adventure-packs-a-submarine-seaplane-and-helipad-277739.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-29T13:45:40+00:00",
