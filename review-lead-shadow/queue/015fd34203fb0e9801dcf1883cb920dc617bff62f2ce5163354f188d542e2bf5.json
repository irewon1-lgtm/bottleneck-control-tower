    "canonical_url": "https://www.northernminer.com/news/perpetua-finds-gold-antimony-near-stibnite-pit/1003897494/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-11-06T13:25:06+00:00",
    "published_at_raw": "2026-11-06T13:25:06+00:00",
    "publication_precision": "TIMESTAMP",
