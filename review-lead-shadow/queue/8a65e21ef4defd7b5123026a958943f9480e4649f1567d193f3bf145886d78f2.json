    "canonical_url": "https://www.freightwaves.com/news/amazon-battles-freight-inflation-as-shipping-costs-jump-11-in-q3",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-10-29T23:26:52+00:00",
    "published_at_raw": "2026-10-29T23:26:52+00:00",
    "publication_precision": "TIMESTAMP",
