    "canonical_url": "https://www.autoevolution.com/news/couple-spent-1-million-on-an-endless-cruise-were-kicked-off-it-after-2-years-277787.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-30T16:21:58+00:00",
    "published_at_raw": "2026-10-30T16:21:58+0000",
    "publication_precision": "TIMESTAMP",
