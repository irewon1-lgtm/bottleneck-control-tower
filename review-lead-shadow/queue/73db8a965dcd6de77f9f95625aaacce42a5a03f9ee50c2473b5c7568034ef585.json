    "collected_at": "2026-11-24T12:06:09.927436+00:00",
    "origin_id": "https://www.biospace.com/business/opinion-biotechs-fear-of-global-expansion-is-overblown-risks-destroying-asset-value/#article",
    "canonical_url": "https://www.biospace.com/business/opinion-biotechs-fear-of-global-expansion-is-overblown-risks-destroying-asset-value",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-24T07:57:00+00:00",
