    "canonical_url": "https://www.autoevolution.com/news/segway-drops-road-legal-xyber-air-class-3-e-bike-costs-a-third-less-than-its-powerful-cousin-277540.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-25T21:23:28+00:00",
