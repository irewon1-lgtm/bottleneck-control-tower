    "canonical_url": "https://www.autoevolution.com/news/new-zenos-e10-is-a-380-hp-british-sports-car-that-weighs-less-than-a-mazda-mx-5-miata-277003.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-14T09:19:15+00:00",
