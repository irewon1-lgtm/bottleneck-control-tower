    "origin_id": "https://www.freightwaves.com/news/kodiak-charger-autonomous-trucks-dallas-laredo",
    "canonical_url": "https://www.freightwaves.com/news/kodiak-charger-autonomous-trucks-dallas-laredo",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-10-09T15:57:20+00:00",
