    "origin_id": "https://www.autoevolution.com/news/porsche-s-ice-powered-macan-is-returning-with-a-new-generation-is-this-what-it-will-look-like-278822.html",
    "canonical_url": "https://www.autoevolution.com/news/porsche-s-ice-powered-macan-is-returning-with-a-new-generation-is-this-what-it-will-look-like-278822.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-24T22:08:01+00:00",
    "published_at_raw": "2026-11-24T22:08:01+0000",
    "publication_precision": "TIMESTAMP",
