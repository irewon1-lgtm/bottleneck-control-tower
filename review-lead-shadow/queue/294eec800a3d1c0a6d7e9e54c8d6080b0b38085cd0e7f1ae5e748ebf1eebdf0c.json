    "canonical_url": "https://www.autoevolution.com/news/2-new-hot-wheels-collectibles-that-will-make-some-happines-for-christmas-278421.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-14T13:40:42+00:00",
