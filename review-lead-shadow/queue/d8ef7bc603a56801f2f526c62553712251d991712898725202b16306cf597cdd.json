    "canonical_url": "https://www.defensenews.com/industry/2026/10/13/lockheed-eyes-fresh-pac-3-interceptor-production-options-for-ukraine-europe/",
    "origin_publisher": "Defense News",
    "published_at": "2026-10-13T17:02:08.345000+00:00",
