    "canonical_url": "https://www.defensenews.com/global/asia-pacific/2026/11/17/new-pact-positions-the-philippines-as-a-defense-hub-for-australian-troops/",
    "origin_publisher": "Defense News",
    "published_at": "2026-11-17T11:29:34+00:00",
