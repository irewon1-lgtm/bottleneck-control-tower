    "origin_id": "https://www.freightwaves.com/news/larger-ups-air-hub-in-philippines-boosts-asia-service-levels",
    "canonical_url": "https://www.freightwaves.com/news/larger-ups-air-hub-in-philippines-boosts-asia-service-levels",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-10-16T14:52:48+00:00",
