    "canonical_url": "https://www.autoevolution.com/news/polaris-rzr-pro-r-factory-boost-will-thunder-through-the-desert-with-400-hp-and-a-200k-sticker-277852.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-02T09:27:26+00:00",
