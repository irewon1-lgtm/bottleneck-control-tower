    "collected_at": "2026-11-26T19:24:21.280005+00:00",
    "origin_id": "https://electrek.co/2026/11/26/tesla-deploys-mobile-superchargers-thanksgiving-travel/",
    "canonical_url": "https://electrek.co/2026/11/26/tesla-deploys-mobile-superchargers-thanksgiving-travel/",
    "origin_publisher": "Electrek",
    "published_at": "2026-11-26T17:33:21+00:00",
    "published_at_raw": "2026-11-26T17:33:21+00:00",
