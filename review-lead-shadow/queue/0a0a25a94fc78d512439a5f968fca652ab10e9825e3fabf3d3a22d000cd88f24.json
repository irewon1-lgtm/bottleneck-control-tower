    "canonical_url": "https://www.autoevolution.com/news/canadian-1971-corvette-454-rocks-holy-grail-ls6-and-automatic-combo-its-rarer-than-dragon-eggs-277750.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-29T18:36:54+00:00",
