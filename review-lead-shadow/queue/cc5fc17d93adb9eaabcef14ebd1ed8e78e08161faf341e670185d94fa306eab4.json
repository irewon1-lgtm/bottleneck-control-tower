    "canonical_url": "https://www.autoevolution.com/news/first-ever-starship-double-catch-means-rocket-flying-over-populated-texas-expect-sonic-booms-278157.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-09T11:41:56+00:00",
