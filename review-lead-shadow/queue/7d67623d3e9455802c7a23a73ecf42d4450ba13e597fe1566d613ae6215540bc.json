    "collected_at": "2026-10-27T15:40:56.985164+00:00",
    "origin_id": "https://www.freightwaves.com/news/double-nickel-launches-ai-agent-to-automate-driver-employment-checks",
    "canonical_url": "https://www.freightwaves.com/news/double-nickel-launches-ai-agent-to-automate-driver-employment-checks",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-10-27T14:41:03+00:00",
    "published_at_raw": "2026-10-27T14:41:03+00:00",
