    "canonical_url": "https://www.biospace.com/business/gilead-snags-equity-stake-in-vir-with-up-to-1-87b-deal-for-three-t-cell-engagers",
    "origin_publisher": "BioSpace",
    "published_at": "2026-10-14T15:01:01.476000+00:00",
