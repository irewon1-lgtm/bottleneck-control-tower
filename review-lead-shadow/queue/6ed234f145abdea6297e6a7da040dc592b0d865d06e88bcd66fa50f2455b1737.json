    "canonical_url": "https://www.biospace.com/fda/capricor-ceo-says-fda-never-gave-dmd-cell-therapy-a-fair-shake",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-23T13:34:05.283000+00:00",
