    "canonical_url": "https://www.autoevolution.com/news/volkswagen-puts-a-price-tag-on-the-2027-california-heres-how-much-the-campervan-costs-277948.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-04T10:45:49+00:00",
