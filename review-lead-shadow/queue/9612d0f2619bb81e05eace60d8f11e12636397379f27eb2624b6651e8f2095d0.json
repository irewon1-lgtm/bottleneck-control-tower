    "canonical_url": "https://www.autoevolution.com/news/honda-avancier-debuts-with-six-seats-new-logo-and-new-hybrid-powertrain-278711.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-20T07:32:22+00:00",
    "published_at_raw": "2026-11-20T07:32:22+0000",
