    "origin_id": "https://www.powermag.com/energy-affordability-depends-on-keeping-battery-ownership-competitive/",
    "canonical_url": "https://www.powermag.com/energy-affordability-depends-on-keeping-battery-ownership-competitive/",
    "origin_publisher": "POWER Magazine",
    "published_at": "2026-11-09T18:10:53+00:00",
    "published_at_raw": "2026-11-09T18:10:53+00:00",
    "publication_precision": "TIMESTAMP",
