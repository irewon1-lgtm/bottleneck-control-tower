    "canonical_url": "https://electrek.co/2026/10/29/rivian-electric-van-awd-30-percent-more-range/",
    "origin_publisher": "Electrek",
    "published_at": "2026-10-29T20:04:01+00:00",
    "published_at_raw": "2026-10-29T20:04:01+00:00",
