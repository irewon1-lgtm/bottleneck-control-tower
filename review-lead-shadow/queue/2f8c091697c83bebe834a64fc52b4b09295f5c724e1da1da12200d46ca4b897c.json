    "origin_id": "https://www.powermag.com/ge-vernova-advances-hydrogen-capabilities-for-aeroderivative-gas-turbines-with-new-milestones/",
    "canonical_url": "https://www.powermag.com/ge-vernova-advances-hydrogen-capabilities-for-aeroderivative-gas-turbines-with-new-milestones/",
    "origin_publisher": "POWER Magazine",
    "published_at": "2026-11-10T17:49:57+00:00",
    "published_at_raw": "2026-11-10T17:49:57+00:00",
