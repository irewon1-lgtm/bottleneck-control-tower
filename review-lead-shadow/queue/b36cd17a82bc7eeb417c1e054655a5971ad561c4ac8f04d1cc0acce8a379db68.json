    "origin_id": "https://www.autoevolution.com/news/ford-police-interceptor-utility-recalled-over-map-lights-that-refuse-to-turn-off-278554.html",
    "canonical_url": "https://www.autoevolution.com/news/ford-police-interceptor-utility-recalled-over-map-lights-that-refuse-to-turn-off-278554.html",
    "origin_publisher": "autoevolution",
