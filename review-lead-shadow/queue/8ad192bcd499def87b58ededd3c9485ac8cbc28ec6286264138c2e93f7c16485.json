    "collected_at": "2026-11-04T13:23:55.725879+00:00",
    "origin_id": "https://www.biospace.com/business/novo-lilly-battle-for-oral-glp-1-dominance-with-data-tit-for-tat/#article",
    "canonical_url": "https://www.biospace.com/business/novo-lilly-battle-for-oral-glp-1-dominance-with-data-tit-for-tat",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-04T12:25:20.385000+00:00",
    "published_at_raw": "2026-11-04T12:25:20.385Z",
    "publication_precision": "TIMESTAMP",
