    "canonical_url": "https://theloadstar.com/air-traffic-strike-disrupts-liege-and-brussels-cargo-ahead-of-black-friday/",
    "origin_publisher": "The Loadstar",
    "published_at": "2026-11-23T12:55:27+00:00",
