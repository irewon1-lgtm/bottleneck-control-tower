    "origin_id": "https://electrek.co/2026/10/25/xcmg-debuts-new-fully-autonomous-electric-terminal-tractor-video/",
    "canonical_url": "https://electrek.co/2026/10/25/xcmg-debuts-new-fully-autonomous-electric-terminal-tractor-video/",
    "origin_publisher": "Electrek",
    "published_at": "2026-10-25T18:34:53+00:00",
