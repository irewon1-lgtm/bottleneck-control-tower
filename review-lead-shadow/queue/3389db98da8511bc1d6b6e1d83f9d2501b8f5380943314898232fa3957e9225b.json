    "canonical_url": "https://www.autoevolution.com/news/all-new-zeekr-7x-is-a-785-horsepower-electric-suv-that-hits-62-mph-in-298-seconds-279116.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-27T12:33:34+00:00",
    "published_at_raw": "2026-11-27T12:33:34+0000",
    "publication_precision": "TIMESTAMP",
