    "collected_at": "2026-11-24T20:28:26.170979+00:00",
    "origin_id": "https://electrek.co/2026/11/24/hyundai-ioniq-3-spotted-us-affordable-ev-images/",
    "canonical_url": "https://electrek.co/2026/11/24/hyundai-ioniq-3-spotted-us-affordable-ev-images/",
    "origin_publisher": "Electrek",
    "published_at": "2026-11-24T20:07:39+00:00",
