    "collected_at": "2026-10-23T14:37:04.983350+00:00",
    "origin_id": "https://electrek.co/2026/10/23/yozma-in-11-review-the-og-mini-e-moto-gets-updates-galore/",
    "canonical_url": "https://electrek.co/2026/10/23/yozma-in-11-review-the-og-mini-e-moto-gets-updates-galore/",
    "origin_publisher": "Electrek",
    "published_at": "2026-10-23T12:39:08+00:00",
