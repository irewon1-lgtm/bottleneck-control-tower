    "canonical_url": "https://www.autoevolution.com/news/this-is-a-one-owner-1964-1-2-mustang-convertible-and-fate-has-been-so-cruel-to-it-276864.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-12T16:30:27+00:00",
