    "collected_at": "2026-11-14T08:42:42.168228+00:00",
    "origin_id": "https://electrek.co/2026/11/13/tesla-cybercab-personal-use-orders-299-subscription-geofence/",
    "canonical_url": "https://electrek.co/2026/11/13/tesla-cybercab-personal-use-orders-299-subscription-geofence/",
    "origin_publisher": "Electrek",
    "published_at": "2026-11-14T02:11:39+00:00",
    "published_at_raw": "2026-11-14T02:11:39+00:00",
