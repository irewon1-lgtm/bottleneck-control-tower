    "origin_id": "https://electrek.co/2026/11/04/kia-ev7-revealed-upcoming-midsize-electric-suv/",
    "canonical_url": "https://electrek.co/2026/11/04/kia-ev7-revealed-upcoming-midsize-electric-suv/",
    "origin_publisher": "Electrek",
    "published_at": "2026-11-04T15:15:08+00:00",
