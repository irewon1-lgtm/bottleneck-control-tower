    "canonical_url": "https://www.biospace.com/drug-development/hhs-pumps-up-to-25m-into-ibogaine-other-psychotropic-drugs-on-veterans-day",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-13T15:36:50.836000+00:00",
