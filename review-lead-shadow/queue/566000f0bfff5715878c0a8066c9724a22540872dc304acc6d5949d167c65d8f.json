    "canonical_url": "https://www.defensenews.com/industry/techwatch/2026/10/15/kratos-combat-drone-completes-first-euro-flight-advances-turbojet-engine-production/",
    "origin_publisher": "Defense News",
    "published_at": "2026-10-15T18:00:00+00:00",
