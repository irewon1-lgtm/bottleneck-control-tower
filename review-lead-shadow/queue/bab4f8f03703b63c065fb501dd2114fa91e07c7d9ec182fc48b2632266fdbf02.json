    "canonical_url": "https://www.autoevolution.com/news/official-lego-new-glenn-rocket-and-jacklyn-landing-barge-set-is-not-sold-by-lego-279028.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-26T09:08:16+00:00",
