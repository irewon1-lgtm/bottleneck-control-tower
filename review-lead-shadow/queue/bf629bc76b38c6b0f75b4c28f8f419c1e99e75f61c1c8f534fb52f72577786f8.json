    "canonical_url": "https://www.autoevolution.com/news/bentley-s-torcal-ev-pushes-new-orders-into-2028-before-production-begins-278544.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-17T11:10:53+00:00",
