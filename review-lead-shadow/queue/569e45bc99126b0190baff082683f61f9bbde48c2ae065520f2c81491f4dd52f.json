    "collected_at": "2026-11-25T16:17:04.676153+00:00",
    "origin_id": "https://www.autoevolution.com/news/detroit-s-automakers-are-being-asked-to-build-america-s-drone-supply-chain-278993.html",
    "canonical_url": "https://www.autoevolution.com/news/detroit-s-automakers-are-being-asked-to-build-america-s-drone-supply-chain-278993.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-25T15:08:35+00:00",
