    "canonical_url": "https://electrek.co/2026/11/14/20k-nissan-nx7-phev-goes-on-sale-with-nearly-200-miles-of-electric-range/",
    "origin_publisher": "Electrek",
    "published_at": "2026-11-14T21:26:03+00:00",
