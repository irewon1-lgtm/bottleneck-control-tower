    "origin_id": "https://www.biospace.com/deals/stoffels-strikes-up-new-biotech-in-return-to-galapagos-cell-therapy-mission/#article",
    "canonical_url": "https://www.biospace.com/deals/stoffels-strikes-up-new-biotech-in-return-to-galapagos-cell-therapy-mission",
    "origin_publisher": "BioSpace",
    "published_at": "2026-10-15T13:58:59.512000+00:00",
