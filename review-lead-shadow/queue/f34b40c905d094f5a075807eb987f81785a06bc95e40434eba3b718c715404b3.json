    "origin_id": "https://www.freightwaves.com/news/sonar-rate-intelligence-adds-intermodal-rates-and-truckload-to-intermodal-conversion-savings",
    "canonical_url": "https://www.freightwaves.com/news/sonar-rate-intelligence-adds-intermodal-rates-and-truckload-to-intermodal-conversion-savings",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-10-08T15:11:45+00:00",
