    "origin_id": "https://www.autoevolution.com/news/mercedes-recalls-a-class-through-glc-line-over-faulty-door-lock-microswitches-278175.html",
    "canonical_url": "https://www.autoevolution.com/news/mercedes-recalls-a-class-through-glc-line-over-faulty-door-lock-microswitches-278175.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-09T17:34:50+00:00",
    "published_at_raw": "2026-11-09T17:34:50+0000",
    "publication_precision": "TIMESTAMP",
