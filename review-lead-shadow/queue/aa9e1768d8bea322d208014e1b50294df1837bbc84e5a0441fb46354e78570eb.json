    "canonical_url": "https://www.autoevolution.com/news/tesla-cybertruck-gets-5000-more-expensive-after-the-latest-price-hike-and-it-makes-no-sense-279012.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-25T22:20:01+00:00",
    "published_at_raw": "2026-11-25T22:20:01+0000",
