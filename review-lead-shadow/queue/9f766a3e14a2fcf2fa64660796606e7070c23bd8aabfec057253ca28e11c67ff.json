    "origin_id": "https://www.biospace.com/business/orbimed-raises-two-new-life-sciences-funds-worth-3b-with-one-aiming-for-asia/#article",
    "canonical_url": "https://www.biospace.com/business/orbimed-raises-two-new-life-sciences-funds-worth-3b-with-one-aiming-for-asia",
    "origin_publisher": "BioSpace",
    "published_at": "2026-10-16T11:50:02.990000+00:00",
