    "origin_id": "https://www.freightwaves.com/news/fake-freight-broker-redirects-273k-seafood-shipment-in-new-jersey-cargo-theft-attempt",
    "canonical_url": "https://www.freightwaves.com/news/fake-freight-broker-redirects-273k-seafood-shipment-in-new-jersey-cargo-theft-attempt",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-10-09T13:39:29+00:00",
