    "canonical_url": "https://www.autoevolution.com/news/2027-chevrolet-silverado-hd-and-gmc-sierra-hd-with-the-l8s-gas-v8-don-t-feature-a-dipstick-278180.html",
    "origin_publisher": "autoevolution",
