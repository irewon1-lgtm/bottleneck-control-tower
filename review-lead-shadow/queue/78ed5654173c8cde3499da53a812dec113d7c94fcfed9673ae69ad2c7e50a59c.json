    "collected_at": "2026-11-20T14:28:31.584818+00:00",
    "origin_id": "https://www.supplychain247.com/article/warehouse-safety-upgrades-automation",
    "canonical_url": "https://www.supplychain247.com/article/warehouse-safety-upgrades-automation",
    "origin_publisher": "Supply Chain 24/7",
    "published_at": "2026-11-20T09:12:00-05:00",
    "published_at_raw": "2026-11-20T09:12:00-05:00",
