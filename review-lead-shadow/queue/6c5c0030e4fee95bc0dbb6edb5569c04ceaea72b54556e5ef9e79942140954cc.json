    "canonical_url": "https://www.autoevolution.com/news/2027-chevrolet-colorado-order-guide-confirms-zr2-desert-boss-edition-s-return-277071.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-15T10:02:11+00:00",
