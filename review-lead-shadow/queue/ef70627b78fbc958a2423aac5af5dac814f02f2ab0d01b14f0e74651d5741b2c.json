    "collected_at": "2026-11-22T13:41:10.406234+00:00",
    "origin_id": "https://www.freightwaves.com/news/borderlands-mexico-truckers-secure-29-agreements-on-highway-safety-after-nationwide-strike",
    "canonical_url": "https://www.freightwaves.com/news/borderlands-mexico-truckers-secure-29-agreements-on-highway-safety-after-nationwide-strike",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-11-22T12:00:00+00:00",
    "published_at_raw": "2026-11-22T12:00:00+00:00",
    "publication_precision": "TIMESTAMP",
