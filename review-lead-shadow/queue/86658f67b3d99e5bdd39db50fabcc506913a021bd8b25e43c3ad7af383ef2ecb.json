    "origin_id": "https://www.autoevolution.com/news/ford-transit-connect-recalled-again-over-rearview-cameras-that-still-don-t-work-277247.html",
    "canonical_url": "https://www.autoevolution.com/news/ford-transit-connect-recalled-again-over-rearview-cameras-that-still-don-t-work-277247.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-19T18:25:57+00:00",
    "published_at_raw": "2026-10-19T18:25:57+0000",
