    "canonical_url": "https://www.biospace.com/drug-development/erascas-early-data-show-profile-that-could-challenge-revmed-in-pancreatic-cancer-analysts",
    "origin_publisher": "BioSpace",
    "published_at": "2026-11-23T16:26:38.477000+00:00",
