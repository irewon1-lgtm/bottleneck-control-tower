    "origin_id": "https://www.northernminer.com/news/tudor-sees-2-3b-value-in-treaty-creek-mine/1003898224/#article",
    "canonical_url": "https://www.northernminer.com/news/tudor-sees-2-3b-value-in-treaty-creek-mine/1003898224/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-11-24T22:03:07+00:00",
    "published_at_raw": "2026-11-24T22:03:07+00:00",
