    "origin_id": "https://www.freightwaves.com/news/borderlands-mexico-cabotage-enforcements-threatening-cross-border-trucking",
    "canonical_url": "https://www.freightwaves.com/news/borderlands-mexico-cabotage-enforcements-threatening-cross-border-trucking",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-11-01T12:00:00+00:00",
    "published_at_raw": "2026-11-01T12:00:00+00:00",
    "publication_precision": "TIMESTAMP",
