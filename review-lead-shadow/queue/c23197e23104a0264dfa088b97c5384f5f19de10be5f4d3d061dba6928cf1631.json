    "collected_at": "2026-10-13T13:03:20.947644+00:00",
    "origin_id": "https://www.autoevolution.com/news/leaked-documents-point-to-hemi-powered-dodge-charger-comeback-276942.html",
    "canonical_url": "https://www.autoevolution.com/news/leaked-documents-point-to-hemi-powered-dodge-charger-comeback-276942.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-13T10:32:01+00:00",
    "published_at_raw": "2026-10-13T10:32:01+0000",
    "publication_precision": "TIMESTAMP",
