    "collected_at": "2026-11-20T21:39:57.823282+00:00",
    "origin_id": "https://www.autoevolution.com/news/honda-is-recalling-the-s2000-roadster-for-fuel-flange-joint-leak-risk-278756.html",
    "canonical_url": "https://www.autoevolution.com/news/honda-is-recalling-the-s2000-roadster-for-fuel-flange-joint-leak-risk-278756.html",
    "origin_publisher": "autoevolution",
