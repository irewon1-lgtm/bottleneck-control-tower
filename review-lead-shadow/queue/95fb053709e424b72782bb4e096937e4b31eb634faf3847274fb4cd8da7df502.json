    "canonical_url": "https://www.autoevolution.com/news/tesla-left-intriguing-hints-in-the-roadster-demo-confirmation-here-s-how-to-watch-the-livestream-277034.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-14T16:44:14+00:00",
    "published_at_raw": "2026-10-14T16:44:14+0000",
