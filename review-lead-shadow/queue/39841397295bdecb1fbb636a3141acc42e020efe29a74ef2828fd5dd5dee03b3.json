    "collected_at": "2026-11-17T21:59:27.284722+00:00",
    "origin_id": "https://electrek.co/2026/11/17/scout-motors-validation-builds-south-carolina-deliveries-2028/",
    "canonical_url": "https://electrek.co/2026/11/17/scout-motors-validation-builds-south-carolina-deliveries-2028/",
    "origin_publisher": "Electrek",
    "published_at": "2026-11-17T21:15:34+00:00",
