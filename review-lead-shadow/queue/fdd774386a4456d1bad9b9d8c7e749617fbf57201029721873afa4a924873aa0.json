    "canonical_url": "https://www.autoevolution.com/news/1970-plymouth-satellite-springs-back-to-life-after-36-years-at-a-farm-too-many-doors-277150.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-16T14:24:55+00:00",
