    "origin_id": "https://www.biospace.com/drug-development/altimmune-gears-up-for-fda-meeting-on-pivotal-phase-3-trial-in-alcohol-use-disorder/#article",
    "canonical_url": "https://www.biospace.com/drug-development/altimmune-gears-up-for-fda-meeting-on-pivotal-phase-3-trial-in-alcohol-use-disorder",
