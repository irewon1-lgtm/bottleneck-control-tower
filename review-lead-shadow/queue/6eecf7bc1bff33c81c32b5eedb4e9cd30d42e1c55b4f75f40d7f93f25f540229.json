    "canonical_url": "https://www.autoevolution.com/news/reggie-jackson-s-ferrari-250-gt-lusso-failed-to-clear-reserve-after-high-bid-hit-11-million-278940.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-24T18:45:25+00:00",
    "published_at_raw": "2026-11-24T18:45:25+0000",
