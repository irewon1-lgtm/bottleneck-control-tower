    "origin_id": "https://www.biospace.com/business/we-need-to-do-better-alnylam-ceo-admits-as-uncertainty-looms-over-transthyretin-franchise/#article",
    "canonical_url": "https://www.biospace.com/business/we-need-to-do-better-alnylam-ceo-admits-as-uncertainty-looms-over-transthyretin-franchise",
    "origin_publisher": "BioSpace",
    "published_at": "2026-10-30T12:46:26.482000+00:00",
