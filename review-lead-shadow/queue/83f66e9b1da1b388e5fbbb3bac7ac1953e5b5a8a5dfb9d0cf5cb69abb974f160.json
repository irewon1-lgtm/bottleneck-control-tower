    "canonical_url": "https://www.freightwaves.com/news/higher-shipment-weights-help-arcbest-beat-q3-expectations",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-11-04T13:52:29+00:00",
    "published_at_raw": "2026-11-04T13:52:29+00:00",
