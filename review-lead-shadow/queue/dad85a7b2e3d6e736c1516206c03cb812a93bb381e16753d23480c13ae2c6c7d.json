    "canonical_url": "https://www.defensenews.com/global/europe/2026/11/09/dutch-firm-optics11-in-talks-with-navies-on-secretive-underwater-listening-tech/",
    "origin_publisher": "Defense News",
    "published_at": "2026-11-09T17:52:01+00:00",
