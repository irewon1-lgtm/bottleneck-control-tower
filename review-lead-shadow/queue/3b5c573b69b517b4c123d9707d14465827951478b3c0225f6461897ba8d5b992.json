    "origin_id": "https://www.autoevolution.com/news/subaru-recalls-2026-crosstrek-and-forester-for-potential-control-arm-ball-joint-separation-277496.html",
    "canonical_url": "https://www.autoevolution.com/news/subaru-recalls-2026-crosstrek-and-forester-for-potential-control-arm-ball-joint-separation-277496.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-24T19:54:39+00:00",
    "published_at_raw": "2026-10-24T19:54:39+0000",
