    "origin_id": "https://www.freightwaves.com/news/federal-dot-grants-will-fund-more-than-2400-parking-spots",
    "canonical_url": "https://www.freightwaves.com/news/federal-dot-grants-will-fund-more-than-2400-parking-spots",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-10-15T21:00:00+00:00",
    "published_at_raw": "2026-10-15T21:00:00+00:00",
