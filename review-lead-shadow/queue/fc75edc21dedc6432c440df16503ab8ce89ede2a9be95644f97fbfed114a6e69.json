    "canonical_url": "https://www.autoevolution.com/news/alder-is-a-popular-west-coast-tiny-home-that-doesn-t-ask-you-to-give-up-much-to-live-more-simply-278292.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-11T21:27:32+00:00",
