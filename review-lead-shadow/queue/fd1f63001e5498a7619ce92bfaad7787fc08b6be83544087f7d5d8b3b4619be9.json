    "canonical_url": "https://www.autoevolution.com/news/new-hot-wheels-elite-64-hauler-is-a-1979-chevy-c30-crew-cab-dually-44-that-will-cost-65-278238.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-10T20:10:54+00:00",
    "published_at_raw": "2026-11-10T20:10:54+0000",
