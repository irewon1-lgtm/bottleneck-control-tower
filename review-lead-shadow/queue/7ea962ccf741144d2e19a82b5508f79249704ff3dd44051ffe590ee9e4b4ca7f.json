    "origin_id": "https://www.northernminer.com/news/gold-miners-trade-at-discount-after-selloff-haywood/1003896128/",
    "canonical_url": "https://www.northernminer.com/news/gold-miners-trade-at-discount-after-selloff-haywood/1003896128/",
    "origin_publisher": "The Northern Miner",
    "published_at": "2026-10-27T13:55:06+00:00",
    "published_at_raw": "2026-10-27T13:55:06+00:00",
