    "origin_id": "https://www.freightwaves.com/news/new-logistics-firm-linked-to-collapsed-rr-transportation-empire",
    "canonical_url": "https://www.freightwaves.com/news/new-logistics-firm-linked-to-collapsed-rr-transportation-empire",
    "origin_publisher": "FreightWaves",
    "published_at": "2026-11-16T18:00:51+00:00",
