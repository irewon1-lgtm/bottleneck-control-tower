    "canonical_url": "https://www.autoevolution.com/news/2027-volkswagen-t-roc-r-drops-camo-at-the-nurburgring-looks-ready-for-unveiling-277375.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-22T09:22:33+00:00",
