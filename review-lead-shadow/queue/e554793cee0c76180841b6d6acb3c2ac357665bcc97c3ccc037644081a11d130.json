    "collected_at": "2026-10-13T20:00:41.550251+00:00",
    "origin_id": "https://www.defensenews.com/industry/techwatch/2026/10/13/us-army-targets-2028-for-first-high-energy-laser-counter-drone-weapons/",
    "canonical_url": "https://www.defensenews.com/industry/techwatch/2026/10/13/us-army-targets-2028-for-first-high-energy-laser-counter-drone-weapons/",
    "origin_publisher": "Defense News",
    "published_at": "2026-10-13T17:45:00+00:00",
