    "origin_id": "https://theloadstar.com/strong-freight-rates-help-hapag-lloyd-profits-soar-despite-loss-of-market-share/#article",
    "canonical_url": "https://theloadstar.com/strong-freight-rates-help-hapag-lloyd-profits-soar-despite-loss-of-market-share/",
    "origin_publisher": "The Loadstar",
    "published_at": "2026-11-12T13:15:18+00:00",
