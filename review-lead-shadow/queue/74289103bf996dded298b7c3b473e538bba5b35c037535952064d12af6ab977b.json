    "canonical_url": "https://www.autoevolution.com/news/new-john-f-kennedy-aircraft-carrier-launches-and-recovers-f35c-jets-for-the-first-time-278754.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-20T16:31:51+00:00",
