    "collected_at": "2026-10-20T14:37:51.207817+00:00",
    "origin_id": "https://electrek.co/2026/10/20/how-electric-school-buses-power-1000-homes-in-california-and-make-money/",
    "canonical_url": "https://electrek.co/2026/10/20/how-electric-school-buses-power-1000-homes-in-california-and-make-money/",
    "origin_publisher": "Electrek",
    "published_at": "2026-10-20T14:00:00+00:00",
