    "canonical_url": "https://www.autoevolution.com/news/canadian-gearhead-bought-survivor-18k-mile-humvee-just-to-be-cool-at-car-meets-did-he-nail-it-277829.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-01T12:53:28+00:00",
