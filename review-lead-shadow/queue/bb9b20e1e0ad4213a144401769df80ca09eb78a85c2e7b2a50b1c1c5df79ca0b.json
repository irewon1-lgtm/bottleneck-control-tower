    "canonical_url": "https://www.autoevolution.com/news/new-vertical-powertrain-center-for-the-valo-evtol-unveiled-in-bristol-278934.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-24T16:58:23+00:00",
