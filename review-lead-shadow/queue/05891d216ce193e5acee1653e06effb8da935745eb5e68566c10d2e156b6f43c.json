    "origin_id": "https://www.servethehome.com/intel-moves-forward-at-ohio-one-with-first-major-structural-truss-installation/#article",
    "canonical_url": "https://www.servethehome.com/intel-moves-forward-at-ohio-one-with-first-major-structural-truss-installation/",
    "origin_publisher": "ServeTheHome",
    "published_at": "2026-10-21T15:00:47+00:00",
    "published_at_raw": "2026-10-21T15:00:47+00:00",
