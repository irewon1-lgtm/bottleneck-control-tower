    "origin_id": "https://breakingdefense.com/2026/11/gambit-series-offers-a-scalable-path-for-collaborative-combat-aircraft/",
    "canonical_url": "https://breakingdefense.com/2026/11/gambit-series-offers-a-scalable-path-for-collaborative-combat-aircraft/",
    "origin_publisher": "Breaking Defense",
    "published_at": "2026-11-03T15:34:52+00:00",
    "published_at_raw": "2026-11-03T15:34:52+00:00",
