    "origin_id": "https://electrek.co/2026/11/20/kia-lucid-vw-slash-ev-prices-by-10000-black-friday/",
    "canonical_url": "https://electrek.co/2026/11/20/kia-lucid-vw-slash-ev-prices-by-10000-black-friday/",
    "origin_publisher": "Electrek",
    "published_at": "2026-11-20T19:59:48+00:00",
    "published_at_raw": "2026-11-20T19:59:48+00:00",
