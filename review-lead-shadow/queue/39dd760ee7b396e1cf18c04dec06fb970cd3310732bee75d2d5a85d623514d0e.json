    "origin_id": "https://www.autoevolution.com/news/1955-ford-fairlane-barned-for-decades-hides-tri-power-surprise-under-the-hood-277304.html",
    "canonical_url": "https://www.autoevolution.com/news/1955-ford-fairlane-barned-for-decades-hides-tri-power-surprise-under-the-hood-277304.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-10-20T22:45:37+00:00",
