    "canonical_url": "https://www.biospace.com/deals/zealand-pens-up-to-1-2b-deal-with-generate-for-ai-designed-obesity-metabolic-drugs",
    "origin_publisher": "BioSpace",
    "published_at": "2026-10-14T13:11:53.254000+00:00",
