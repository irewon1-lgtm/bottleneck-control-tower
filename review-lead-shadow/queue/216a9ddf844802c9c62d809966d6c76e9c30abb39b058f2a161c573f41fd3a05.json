    "canonical_url": "https://www.autoevolution.com/news/audi-is-making-just-182-nuvolari-supercars-for-the-us-market-it-asks-700000-for-one-278289.html",
    "origin_publisher": "autoevolution",
    "published_at": "2026-11-11T18:28:42+00:00",
