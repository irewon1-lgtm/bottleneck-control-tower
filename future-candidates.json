      "body_sha256": null,
      "candidate": true,
      "decision": "CANDIDATE_ONLY",
      "reason": null,
      "evidence": {
        "DEMAND": [
          "A shipper plans around its own demand and service requirements."
        ],
        "CONSTRAINT": [
          "Doing it across millions of shipments, carriers, locations, appointment windows and operating constraints is not."
        ],
        "CAPACITY_LEAD_TIME": [
          "Fuel prices will move, tariffs will change, and capacity will tighten and loosen.",
          "No movement exists in isolation, and every movement affects where capacity is available and what can move next."
        ],
        "TIMING": [
          "The American Transportation Research Institute’s latest report , released last month, puts the average cost of operating a truck in 2025 at $2.336 per mile, the highest in the report’s history.",
          "The industry has spent years getting better at optimizing individual parts of this system."
        ]
      },
