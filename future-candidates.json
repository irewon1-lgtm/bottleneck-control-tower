    "8d037457-3d0c-4574-8787-8601b93a15c5": {
      "id": "8d037457-3d0c-4574-8787-8601b93a15c5",
      "title": "The Death of Pure JIT: Why Electronics Manufacturing Demands Strategic Buffering",
      "url": "https://www.supplychainbrain.com/blogs/1-think-tank/post/44655-the-death-of-pure-jit-why-electronics-manufacturing-demands-strategic-buffering",
      "source": "www.supplychainbrain.com",
      "collected_at": "2026-09-30T22:02:08.578835+00:00",
      "updated_at": "2026-09-30T22:02:08.578846+00:00",
